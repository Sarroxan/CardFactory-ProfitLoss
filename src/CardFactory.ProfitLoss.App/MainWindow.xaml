<Window x:Class="CardFactory.ProfitLoss.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:CardFactory.ProfitLoss.App.ViewModels"
        xmlns:views="clr-namespace:CardFactory.ProfitLoss.App.Views"
        xmlns:converters="clr-namespace:CardFactory.ProfitLoss.App.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Card Factory Profit &amp; Loss Calculator"
        Icon="Assets/CardFactory.ProfitLoss.ico"
        Width="1230"
        Height="770"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        Background="White"
        Language="en-GB"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SourceInitialized="Window_SourceInitialized"
        StateChanged="Window_StateChanged"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed">

    <!-- Stage 6A.84: the window is a fixed size. ResizeMode="CanMinimize" removes the
         user's ability to resize it, and the chrome's resize border is zeroed to match -
         left at 8 it would still offer a drag grip that no longer does anything. The app
         still sizes itself: FitToWorkArea on startup and the team-row growth. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            CornerRadius="20"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <converters:ZeroBlankDecimalConverter x:Key="ZeroBlankDecimalConverter" />
        <converters:StringEqualsConverter x:Key="StringEqualsConverter" />

        <Style x:Key="HistoricalModeToggleStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="70" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="{StaticResource CfDeepBlue}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource CfLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Segment"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Segment" Property="BorderBrush" Value="#AFC4DE" />
                                <Setter TargetName="Segment" Property="Background" Value="#F5F9FF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="{StaticResource CfBlue}" />
                                <Setter TargetName="Segment" Property="BorderBrush" Value="{StaticResource CfBlue}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Segment" Property="BorderBrush" Value="{StaticResource CfYellow}" />
                                <Setter TargetName="Segment" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stage 6B.48 (concept B): Day / Range as one card split in two, the same size,
             border and corners as the target cards beside it. Each half fills its side of
             the card; its outer corners come from Tag (13 = the card's 14 less its 1px
             border), because ClipToBounds clips to a rectangle, not to rounded corners.
             HistoricalModeToggleStyle is left as it is - Performance / Gift Cards uses it. -->
        <Style x:Key="ModeCardSegmentStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource CfDeepBlue}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Half"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Half" Property="Background" Value="#F5F9FF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Half" Property="Background" Value="{StaticResource CfBlue}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource CfYellow}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Transparent hit-area style used over exact HTML-rendered Chewy button artwork. -->
        <Style x:Key="ExactArtworkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.96" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.82" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        
        <Style x:Key="AppChromeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeB" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChromeB" Property="Background" Value="#EDF4FC" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ChromeB" Property="Background" Value="#DCEAF8" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource AppChromeButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FFF0F1" /></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowFrame"
            Background="White"
            BorderBrush="{StaticResource CfLine}"
            BorderThickness="1"
            CornerRadius="20"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom application chrome. This replaces the default square Windows title bar. -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="{StaticResource CfLineSoft}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="20,20,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Stage 6A.28: restore a clearly visible application icon in the custom title bar. -->
                        <Image Width="30"
                               Height="30"
                               Source="Assets/HeaderSmiley.png"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Card Factory Profit &amp; Loss Calculator"
                                   Foreground="{StaticResource CfDeepBlue}"
                                   FontFamily="Arial"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="7,0,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Version chip, design H2: the Menu button's outline pill with a face.
                             Unknown (checking): just "v1.1.0", muted, no face. UpToDate: green smile.
                             Available: plain yellow face, yellow border on pale yellow - the only
                             clickable state, opens the update box. CantCheck: red sad face. -->
                        <Button x:Name="VersionChip" Click="VersionChip_Click" Height="24" Tag="Unknown"
                                Margin="0,0,8,0" VerticalAlignment="Center" FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Chip" Background="White" BorderBrush="{StaticResource CfDeepBlue}" BorderThickness="1.5" CornerRadius="12" Padding="4,0,11,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Viewbox x:Name="FaceHappy" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed">
                                                <Canvas Width="20" Height="20">
                                                    <Ellipse Canvas.Left="0.8" Canvas.Top="0.8" Width="18.4" Height="18.4" Fill="#2FB866" Stroke="#0B7A35" StrokeThickness="1.2" />
                                                    <Ellipse Canvas.Left="5.5" Canvas.Top="6.3" Width="3" Height="3" Fill="{StaticResource CfDeepBlue}" />
                                                    <Ellipse Canvas.Left="11.5" Canvas.Top="6.3" Width="3" Height="3" Fill="{StaticResource CfDeepBlue}" />
                                                    <Path Data="M5.8,11.6 Q10,16.4 14.2,11.6" Stroke="{StaticResource CfDeepBlue}" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                </Canvas>
                                            </Viewbox>
                                            <Viewbox x:Name="FacePlain" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed">
                                                <Canvas Width="20" Height="20">
                                                    <Ellipse Canvas.Left="0.8" Canvas.Top="0.8" Width="18.4" Height="18.4" Fill="{StaticResource CfYellow}" Stroke="#B88A00" StrokeThickness="1.2" />
                                                    <Ellipse Canvas.Left="5.5" Canvas.Top="6.3" Width="3" Height="3" Fill="{StaticResource CfDeepBlue}" />
                                                    <Ellipse Canvas.Left="11.5" Canvas.Top="6.3" Width="3" Height="3" Fill="{StaticResource CfDeepBlue}" />
                                                    <Path Data="M6.4,13 L13.6,13" Stroke="{StaticResource CfDeepBlue}" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                </Canvas>
                                            </Viewbox>
                                            <Viewbox x:Name="FaceSad" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed">
                                                <Canvas Width="20" Height="20">
                                                    <Ellipse Canvas.Left="0.8" Canvas.Top="0.8" Width="18.4" Height="18.4" Fill="#E5484D" Stroke="#9E2A2E" StrokeThickness="1.2" />
                                                    <Ellipse Canvas.Left="5.5" Canvas.Top="6.3" Width="3" Height="3" Fill="{StaticResource CfDeepBlue}" />
                                                    <Ellipse Canvas.Left="11.5" Canvas.Top="6.3" Width="3" Height="3" Fill="{StaticResource CfDeepBlue}" />
                                                    <Path Data="M5.8,14.6 Q10,10.2 14.2,14.6" Stroke="{StaticResource CfDeepBlue}" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock x:Name="ChipText" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center"
                                                       Margin="7,0,0,0" FontFamily="Arial" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource CfMuted}" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="Tag" Value="UpToDate">
                                            <Setter TargetName="FaceHappy" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource CfDeepBlue}" />
                                            <Setter TargetName="ChipText" Property="Margin" Value="0" />
                                            <Setter Property="Cursor" Value="Hand" />   <!-- click to check again -->
                                        </Trigger>
                                        <Trigger Property="Tag" Value="Available">
                                            <Setter TargetName="FacePlain" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Chip" Property="Background" Value="#FFFBEA" />
                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource CfYellow}" />
                                            <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource CfDeepBlue}" />
                                            <Setter TargetName="ChipText" Property="Margin" Value="0" />
                                            <Setter Property="Cursor" Value="Hand" />
                                        </Trigger>
                                        <Trigger Property="Tag" Value="CantCheck">
                                            <Setter TargetName="FaceSad" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource CfDeepBlue}" />
                                            <Setter TargetName="ChipText" Property="Margin" Value="0" />
                                            <Setter Property="Cursor" Value="Hand" />   <!-- click to check again -->
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="Tag" Value="Available" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Chip" Property="Background" Value="#FFF3C2" />
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Stage 6B.68 (M3): a labelled "Menu" pill in the Add person style, so it no
                             longer looks like a third window button beside minimise and close. -->
                        <Button x:Name="MenuButton" ToolTip="Menu" Click="MenuButton_Click" Width="68" Height="24"
                                Margin="0,0,8,0" VerticalAlignment="Center" Cursor="Hand" FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="MenuPill" Background="White" BorderBrush="{StaticResource CfDeepBlue}"
                                            BorderThickness="1.5" CornerRadius="12">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="M3,5 L15,5 M3,9 L15,9 M3,13 L15,13" Stroke="{StaticResource CfDeepBlue}" StrokeThickness="1.9"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                                            <TextBlock Text="Menu" Margin="6,0,0,0" VerticalAlignment="Center"
                                                       FontFamily="Arial" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource CfDeepBlue}" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="MenuPill" Property="Background" Value="#F5F9FF" /></Trigger>
                                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="MenuPill" Property="Background" Value="#E4EDF7" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Style="{StaticResource AppChromeButtonStyle}" ToolTip="Minimise" Click="MinimiseButton_Click">
                            <Path Data="M3,9 L15,9" Stroke="{StaticResource CfDeepBlue}" StrokeThickness="1.6" StrokeStartLineCap="Round" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <!-- Stage 6A.83: no maximise button. The dashboard is a fixed
                             composition and stretching it to a full screen spreads
                             everything out badly, so the window is deliberately kept off
                             that path. Minimise and Close remain. -->
                        <Button Style="{StaticResource AppCloseButtonStyle}" ToolTip="Close" Click="CloseButton_Click">
                            <Path Data="M4,4 L14,14 M14,4 L4,14" Stroke="#A91E2C" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Background="White">

        <!--
            Stage 6A.13: final visual/stability polish with a cleaner header, relocated Historical Target, restored preferred icons and hardened numeric input behavior. The audited HTML-style calculator keeps its proportions,
            but the window is sized around the dashboard so it sits close to the rounded frame
            instead of floating in the middle. There are no page-level scrollbars. The inner
            Team Performance list remains the only area allowed to scroll when required.
        -->
        <Viewbox x:Name="HomeViewbox"
                 Stretch="Uniform"
                 StretchDirection="Both"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch"
                 Margin="0"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 SnapsToDevicePixels="False">
                <Border x:Name="CalculatorView"
                        Width="1220"
                        Padding="4,10,4,10"
                        Background="White"
                        BorderThickness="0"
                        CornerRadius="0">

                    <StackPanel Width="1212">
                        <!-- HEADER: restored preferred HTML smiley, cleaner metadata spacing and compact Flooid status. -->
                        <!-- Stage 6B.21: the header was three things on white - logo, tabs, login
                             pill - with 190px of nothing between the tabs and the pill, which is
                             what made it read as bare. A tint gives it a body, and the gap now
                             carries the two facts every figure on this page depends on: which
                             store and which day. The bottom rule stays #DCE6F3 rather than yellow,
                             because 6B.06 reserved yellow for the controls you act on and a yellow
                             rule across the whole header would undo that. -->
                        <!-- Stage 6B.60: navy header, the chosen colour (navy). CfDeepBlue with the app's 14px card radius; no rule needed.
                             Everything on it is recoloured to suit: white logo lettering, white
                             tabs, white/pale-blue store details. The Flooid pill keeps its own
                             blue and yellow border. -->
                        <Border Height="93" Background="{StaticResource CfDeepBlue}" CornerRadius="14">
                            <Canvas Width="1212" Height="93" ClipToBounds="False">
                                <!-- Stage 6A.71: supplied combined logo + title artwork replaces the
                                     separately drawn smiley tile and the captured Chewy title image.
                                     Cropped to its ink so it sits flush at the left of the header.
                                     Stage 6B.58: concept F2 - the same smiley, "Card Factory", "Profit &
                                     Loss" in Chewy, and CALCULATOR between two yellow bars the width of the
                                     title. 6B.60: S1 (+2px title letter spacing) in white for the navy
                                     header, 991x252 (3x), shown at 330x84. tools/render-header-logo.py. -->
                                <!-- The logo as vector shapes (tools/header-logo-xaml.py) instead of the 991x252 picture,
                                     so it is sharp at any scale: the same smiley, letters and bars, each letter where the
                                     old artwork had it (within 0.3px). The Viewbox fits it to the old 330x84 slot.
                                     The smiley's square is see-through here (HeaderSmileyFace.png), so it is
                                     the header's own blue rather than the brighter #0056BD of HeaderSmiley.png,
                                     which the title bar and sign-in window still use on white. -->
                                <Viewbox Canvas.Left="0" Canvas.Top="4" Width="330" Height="84" Stretch="Uniform">
                                    <Canvas Width="330.33" Height="84">

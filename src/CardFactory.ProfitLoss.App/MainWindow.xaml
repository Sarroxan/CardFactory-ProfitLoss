                                </Viewbox>

                                <!-- Stage 6A.32: Branch Performance uses the previously empty header space. -->
                                <!-- Stage 6B.05: concept FF. No box - two underline tabs. The logo
                                     above already sets its title over a yellow rule, so this repeats
                                     the header's own device rather than placing another object in it.

                                     Moved left from 720 to 470. The header was bunched to the right:
                                     308px of dead space sat between the logo and this control while
                                     only 40px separated it from the login pill. At 470 with a 190px
                                     width it clears the logo comfortably and leaves the empty space in
                                     the middle, where it reads as spacing rather than a gap. Nothing
                                     else in the header moves. -->
                                <!-- Stage 6B.08: full names. Width is no longer fixed - the Grid sizes
                                     to its content, so the labels set the width rather than a number
                                     guessed here. Left stays at 470, so the block now runs roughly
                                     470-820 against a 1212 header, putting its middle near the centre
                                     of the screen without the tabs being centred in the gap or moved
                                     onto separate lines. The 26px gap between them drops to 20: with
                                     labels three times longer, the old gap read as a gulf. -->
                                <!-- Stage 6B.59: header layout B - the tabs
                                     sit exactly in the centre of the header, between the logo on the left
                                     and the store details + pill on the right. The Grid spans the full
                                     1212px with star columns either side, so the pair centres itself
                                     whatever the label widths; with no Background its empty columns are
                                     not hit-testable, so the logo and pill stay clickable beneath it. -->
                                <Grid x:Name="SectionTabControl"
                                      Canvas.Left="0"
                                      Canvas.Top="24"
                                      Width="1212"
                                      Height="44">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="TeamSectionSegment"
                                            Grid.Column="1"
                                            Tag="Active"
                                            Style="{StaticResource SectionTabButtonStyle}"
                                            Click="TeamSection_Click"
                                            ToolTip="Show Team Performance">
                                        <TextBlock Text="Team Performance" />
                                    </Button>
                                    <Button x:Name="BranchSectionSegment"
                                            Grid.Column="3"
                                            Style="{StaticResource SectionTabButtonStyle}"
                                            Click="BranchSection_Click"
                                            ToolTip="Show Branch Performance">
                                        <TextBlock Text="Branch Performance" />
                                    </Button>
                                    <Button x:Name="ReportsSectionSegment"
                                            Grid.Column="5"
                                            Style="{StaticResource SectionTabButtonStyle}"
                                            Click="ReportsSection_Click"
                                            ToolTip="Show voids, returns and no sales by person">
                                        <TextBlock Text="Reports" />
                                    </Button>
                                </Grid>

                                <!-- Stage 6A.33: user-approved FLOOID LOGIN cloud/keyhole pill. -->
                                <!-- Stage 6B.21: store, date and last retrieval, right-aligned into
                                     the gap ahead of the login pill. Right-aligned so a long outlet
                                     name grows leftwards into empty space instead of pushing the
                                     pill. -->
                                <!-- Stage 6B.59 (layout B): grouped with the pill - 24px from it, as drawn
                                     - and 250 wide so its box ends clear of the centred tabs. -->
                                <StackPanel Canvas.Left="760"
                                            Canvas.Top="26"
                                            Width="250"
                                            HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding HeaderStoreText}"
                                               HorizontalAlignment="Right"
                                               FontFamily="Arial" FontSize="12" FontWeight="Bold"
                                               Foreground="White"
                                               TextTrimming="CharacterEllipsis" />
                                    <!-- Freshness (design 1A): green dot and "updated 12 min ago"; after an hour
                                         the dot and the words turn amber. -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                        <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#35C46F" />
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStale}" Value="True"><Setter Property="Fill" Value="#F5A623" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding HasUpdateTime}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock FontFamily="Arial" FontSize="10" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#D6E4F5" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStale}" Value="True">
                                                            <Setter Property="Foreground" Value="#FFD27A" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                            <Run Text="{Binding SelectedDate, StringFormat='ddd d MMM', Mode=OneWay}" />
                                            <Run Text="{Binding HeaderUpdatedText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Stage 6B.27: concept MA. Opens from the pill when signed in, in place
                                     of reopening the Flooid window, which was not useful once connected.
                                     A Popup is its own window, so WebView2 airspace cannot affect it. -->
                                <Popup x:Name="FlooidAccountMenu"
                                       PlacementTarget="{Binding ElementName=FlooidConnectButton}"
                                       Placement="Bottom"
                                       HorizontalOffset="-48"
                                       VerticalOffset="6"
                                       StaysOpen="False"
                                       AllowsTransparency="True">
                                    <Popup.Resources>
                                        <Style x:Key="AccountMenuItemStyle" TargetType="Button">
                                            <Setter Property="Foreground" Value="{StaticResource CfDeepBlue}" />
                                            <Setter Property="FontFamily" Value="Arial" />
                                            <Setter Property="FontSize" Value="11.5" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Row" Background="Transparent" Padding="12,8"
                                                                BorderBrush="#EDF1F6" BorderThickness="0,1,0,0">
                                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Row" Property="Background" Value="#F1F6FC" />
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Foreground" Value="#9AB4D2" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Popup.Resources>
                                    <Border Background="White" BorderBrush="#D4DEEA" BorderThickness="1"
                                            CornerRadius="12" Width="220" Margin="0,0,0,6">
                                        <StackPanel>
                                            <!-- Stage 6B.70 (R1): navy band, like the main menu and the dialogs. -->
                                            <Border Background="{StaticResource CfDeepBlue}" CornerRadius="11,11,0,0" Padding="12,9">
                                                <StackPanel>
                                                    <TextBlock x:Name="AccountMenuStore" FontFamily="Arial" FontSize="12" FontWeight="Bold"
                                                               Foreground="White" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Name="AccountMenuUser" FontFamily="Arial" FontSize="10"
                                                               Foreground="#D6E4F5" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <!-- Stage 6B.50: only for accounts Flooid gives a choice of stores. -->
                                            <Button x:Name="AccountChangeStoreButton" Content="Change store"
                                                    Style="{StaticResource AccountMenuItemStyle}"
                                                    Visibility="Collapsed"
                                                    Click="AccountChangeStore_Click" />
                                            <Button Content="Sign out" Style="{StaticResource AccountMenuItemStyle}"
                                                    Click="AccountSignOut_Click" />
                                            <Button x:Name="AccountForgetButton" Content="Forget saved sign-in"
                                                    Style="{StaticResource AccountMenuItemStyle}"
                                                    Click="AccountForget_Click" />
                                            <Button Content="Open Flooid back office" Style="{StaticResource AccountMenuItemStyle}"
                                                    Click="AccountOpenFlooid_Click" />
                                        </StackPanel>
                                    </Border>
                                </Popup>

                                <!-- Stage 6B.27: compact, as drawn in the account menu mockup. Was
                                     196x48, which read as bulky next to the text tabs and the store
                                     line. Right edge held at 1206 and vertical centre held at 45, so
                                     it shrinks in place and nothing else in the header moves. -->
                                <Button x:Name="FlooidConnectButton"
                                        Canvas.Left="1034"
                                        Canvas.Top="27"
                                        Width="172"
                                        Height="36"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        ToolTip="{Binding FlooidStatusText}"
                                        Click="FlooidConnect_Click">
                                    <!-- Stage 6A.95: concept K. Blue fill with a
                                         yellow edge is the pairing the section headers already use, so the button
                                         reads as part of the app rather than a badge on it. The box is unchanged -
                                         same 196x48 at the same place on the canvas - so nothing else in the header
                                         moves; only the contents differ.

                                         The cloud-and-keyhole artwork is gone. It was approved at Stage 6A.33, but
                                         it was drawn in CfBlue and would have disappeared into a blue fill, and the
                                         status dot it carried in its corner now stands on its own. The two Path
                                         geometries are recoverable from git history if it is ever wanted back.

                                         Dot colours are lifted for a blue background: the greys and greens used on
                                         the old white pill go muddy here. -->
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <!-- Stage 6B.62: option 1 from the pill concepts - white with navy text and
                                                 the yellow border, so it stands out on the navy header (6B.60). The grey
                                                 dot is darker (#8A99AD) to read on white, and the yellow "signing in"
                                                 dot gets a thin navy ring for the same reason. -->
                                            <Border x:Name="FlooidPill" Background="White" BorderBrush="{StaticResource CfYellow}" BorderThickness="2" CornerRadius="18">
                                                <Grid Margin="13,0,11,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                                                    <Ellipse x:Name="FlooidTemplateStatusDot" Grid.Column="0" Width="9" Height="9" Fill="#8A99AD" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBlock x:Name="FlooidConnectText" Grid.Column="1" Text="FLOOID LOGIN" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <Path x:Name="FlooidConnectArrow" Grid.Column="2" Data="M2,8 L16,8 M11,3 L16,8 L11,13" Stroke="{StaticResource CfDeepBlue}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FlooidPill" Property="Background" Value="#FFF8D8"/></Trigger>
                                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="FlooidPill" Property="Background" Value="#FFF0A8"/></Trigger>
                                                <!-- Signed in: green dot, the label says so, and the arrow goes - there is
                                                     nothing to go to. The button stays clickable on purpose: reopening the
                                                     window is still the only way to force a fresh sign-in when Flooid has
                                                     timed the session out. -->
                                                <Trigger Property="Tag" Value="Good">
                                                    <Setter TargetName="FlooidTemplateStatusDot" Property="Fill" Value="#35C46F"/>
                                                    <Setter TargetName="FlooidConnectText" Property="Text" Value="CONNECTED"/>
                                                    <Setter TargetName="FlooidConnectArrow" Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                                <Trigger Property="Tag" Value="Working">
                                                    <Setter TargetName="FlooidTemplateStatusDot" Property="Fill" Value="{StaticResource CfYellow}"/>
                                                    <Setter TargetName="FlooidTemplateStatusDot" Property="Stroke" Value="{StaticResource CfDeepBlue}"/>
                                                    <Setter TargetName="FlooidTemplateStatusDot" Property="StrokeThickness" Value="1.5"/>
                                                </Trigger>
                                                <Trigger Property="Tag" Value="Bad"><Setter TargetName="FlooidTemplateStatusDot" Property="Fill" Value="#FF6B73"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                               </Button>
                            </Canvas>
                        </Border>

                        <!-- Stage 6A.30: the mode toggle stays left; adaptive Period is right-aligned with the target cards. -->
                        <Grid x:Name="HistoricalTargetRow" Height="30" Margin="18,6,18,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Stage 6B.10: the mode toggle moved down into the targets row. This
                                 row had TARGET and the toggle on the left, Refresh and PERIOD on the
                                 right, and roughly 560px of nothing between them; the toggle now uses
                                 space that was already there and the row loses nothing but dead air. -->

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <!-- Stage 6B.70 (P1): the date as a card like the targets - white, the
                                     CfLine edge and a pale-blue label segment - instead of a pale-yellow
                                     pill with PERIOD floating beside it. The row is 30px tall, so the
                                     label sits at the left rather than on top. Yellow stays for Refresh. -->
                                <Border Height="30"
                                        Background="White"
                                        BorderBrush="{StaticResource CfLine}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="0,1,0,1">
                                    <!-- K1: one button. It opens the calendar, where Single day or Date range
                                         is chosen. Shows "Thu 24/09/2026", or a range with its day count. -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="{StaticResource CfBlueSoft}" CornerRadius="9,0,0,9" Margin="0,-1,8,-1" Padding="10,0">
                                            <TextBlock Text="{Binding PeriodLabel}" VerticalAlignment="Center" Foreground="{StaticResource CfBlue}"
                                                       FontFamily="Arial" FontSize="9.5" FontWeight="Bold" />
                                        </Border>
                                        <Button MinWidth="145"
                                                Height="26"
                                                Padding="8,0"
                                                Style="{StaticResource ThemedPeriodDateButtonStyle}"
                                                Click="PeriodDate_Click"
                                                ToolTip="Choose a single day or a date range">
                                            <TextBlock Text="{Binding PeriodDisplayText}"
                                                       FontFamily="Arial"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource CfDeepBlue}"
                                                       VerticalAlignment="Center" />
                                        </Button>
                                        <TextBlock Text="{Binding RangeDayCountText}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource CfMuted}"
                                                   FontFamily="Arial"
                                                   FontSize="9.5"
                                                   FontWeight="Bold"
                                                   Margin="2,0,6,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRangeMode}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- R1 (owner, 14 Oct): Refresh is the yellow end of the date card -
                                             day, date, then the action, one unit - so it reads as "pull
                                             this date". On Reports it reads "Generate reports" with a report
                                             mark (Tag="Reports") and pulls only the Reports reports; see
                                             SetBranchPerformanceView. Stage 6B.01: one Refresh for all sections. -->
                                        <Button x:Name="RefreshButton"
                                                Content="Refresh"
                                                Style="{StaticResource DateCardActionButtonStyle}"
                                                Height="30"
                                                Margin="0,-1,0,-1"
                                                Click="GrabFromFlooid_Click"
                                                ToolTip="Refresh Team and Branch Performance from Flooid" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- L3: the target inputs moved down into the Targets section, beside their
                             results, and Day / Range into the calendar (K1). The row is kept, collapsed,
                             because the team-row compaction in code still sets its margin. -->
                        <Grid x:Name="TargetsRow" Visibility="Collapsed" Margin="18,5,18,0" />

                        <!-- TEAM PERFORMANCE: exact accepted HTML geometry. -->
                        <!-- Stage 6B.06: colour discipline. Yellow was doing five separate jobs on
                             this page - underlining each target label, ringing the Sales +/- boxes,
                             outlining every section bar, badging them, and now filling Refresh and
                             the active tab. A colour that marks everything marks nothing, and the
                             new yellow controls had to compete with all of it. Yellow is now
                             reserved for what you act on: Refresh, the active tab, and the formula
                             strip's accent. The bars keep a deep blue edge instead, the target
                             fields their existing grey border, and the totals boxes a quiet field. -->
                        <!-- Stage 6B.63: the three section bars (Team, Branch, Performance Summary) are
                             CfDeepBlue, the navy of the header (6B.60). Their title artwork was re-cut with a transparent background - it had
                             the old blue baked in. Yellow stays reserved for what you act on (6B.06). -->
                        <StackPanel x:Name="TeamPerformanceSection" Margin="0,11,0,0">
                            <Grid>
                                <StackPanel x:Name="TeamModePanel">
                            <Canvas Height="42" Width="1212" ClipToBounds="False">
                                <Border Canvas.Left="28" Canvas.Top="0" Width="1184" Height="42"
                                        Background="{StaticResource CfBlue}"
                                        BorderBrush="{StaticResource CfYellow}"
                                        BorderThickness="3,3,3,0"
                                        CornerRadius="16,16,0,0">
                                    <TextBlock Text="Team Performance" Style="{StaticResource SectionTitleTextStyle}" />
                                </Border>
                                <!-- Stage 6B.11: the Team status text is gone; the retrieval overlay reports progress and failure now. -->
                                <!-- Stage 6B.01: the Refresh button that stood here has moved to the
                                     target row, beside PERIOD. The status text beside it stays - it
                                     still reports this section's own outcome. -->
                                <Image Canvas.Left="-4" Canvas.Top="-12"
                                       Width="66" Height="66"
                                       Source="Assets/SectionSmiley.png"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       SnapsToDevicePixels="False" />
                            </Canvas>

                            <Border Width="1184"
                                    Margin="28,0,0,0"
                                    HorizontalAlignment="Left"
                                    Background="White"
                                    BorderBrush="{StaticResource CfLine}"
                                    BorderThickness="1,0,1,1"
                                    CornerRadius="0,0,13,13"
                                    ClipToBounds="True">
                                <StackPanel Width="1182">
                                    <!-- Top performers strip (design C1): best ABV, AUB and P&amp;L in pale-gold
                                         chips. Only shown once someone qualifies (10+ transactions). -->
                                    <Border Height="36" BorderBrush="#EDF1F6" BorderThickness="0,0,0,1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasTopPerformers}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <ItemsControl ItemsSource="{Binding TopPerformerChips}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="24" Margin="6,0" Padding="8,0,11,0" CornerRadius="12"
                                                            Background="#FFFBEA" BorderBrush="#F0DE94" BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Path Data="M10,1.8 L12.5,7.2 L18.3,7.8 L13.9,11.7 L15.2,17.5 L10,14.5 L4.8,17.5 L6.1,11.7 L1.7,7.8 L7.5,7.2 Z" Fill="#E0A800" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Label}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource CfMuted}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" />
                                                            <TextBlock Text="{Binding Names}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="11" FontWeight="Bold" />
                                                            <TextBlock Text="{Binding Value}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                       FontFamily="Arial" FontSize="11" FontWeight="Bold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource CfDeepBlue}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding State}" Value="Good"><Setter Property="Foreground" Value="{StaticResource CfGood}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding State}" Value="Bad"><Setter Property="Foreground" Value="{StaticResource CfBad}" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                    <!-- Stage 6B.67 (T1): live headings - navy Arial on the pale strip - in the
                                         rows' own columns. They were a captured image in Baloo 2, a font nothing
                                         else in the app uses. The Branch headings now match. -->
                                    <Border Height="34.5" Background="{StaticResource CfBlueSoft}">
                                        <Grid Width="1182">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="98" /><ColumnDefinition Width="98" /><ColumnDefinition Width="94" /><ColumnDefinition Width="104" /><ColumnDefinition Width="108" /><ColumnDefinition Width="112" /><ColumnDefinition Width="92" /><ColumnDefinition Width="92" /><ColumnDefinition Width="88" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="NAME" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="TOTAL SALES" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="GIFT CARD QTY" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="GIFT CARDS" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="TRANSACTIONS" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="UNITS SOLD" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent"
                                                        ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="20000" ToolTip="Total sales minus gift cards. Gift Cards are excluded from Counted Sales; Gift Card Qty is excluded from Units Sold only. Transactions remain unchanged for final ABV and AUB.">
                                                <TextBlock Text="COUNTED SALES" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" />
                                                <Border Width="12" Height="12" CornerRadius="6" BorderBrush="{StaticResource CfBlue}" BorderThickness="1.2" Margin="4,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="i" FontFamily="Arial" FontSize="8" FontWeight="Bold" Foreground="{StaticResource CfBlue}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent"
                                                        ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="20000" ToolTip="ABV = (Total sales − Gift cards) ÷ Transactions">
                                                <TextBlock Text="ABV" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" />
                                                <Border Width="12" Height="12" CornerRadius="6" BorderBrush="{StaticResource CfBlue}" BorderThickness="1.2" Margin="4,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="i" FontFamily="Arial" FontSize="8" FontWeight="Bold" Foreground="{StaticResource CfBlue}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="8" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent"
                                                        ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="20000" ToolTip="AUB = (Units sold − Gift Card Qty) ÷ Transactions">
                                                <TextBlock Text="AUB" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" />
                                                <Border Width="12" Height="12" CornerRadius="6" BorderBrush="{StaticResource CfBlue}" BorderThickness="1.2" Margin="4,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="i" FontFamily="Arial" FontSize="8" FontWeight="Bold" Foreground="{StaticResource CfBlue}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="9" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent"
                                                        ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="20000" ToolTip="P&amp;L = (ABV − ABV target) × Transactions">
                                                <TextBlock Text="P&amp;L" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" />
                                                <Border Width="12" Height="12" CornerRadius="6" BorderBrush="{StaticResource CfBlue}" BorderThickness="1.2" Margin="4,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="i" FontFamily="Arial" FontSize="8" FontWeight="Bold" Foreground="{StaticResource CfBlue}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <ScrollViewer x:Name="TeamScrollViewer" VerticalScrollBarVisibility="Hidden"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  MaxHeight="130.5"
                                                  CanContentScroll="True">
                                        <ScrollViewer.Resources>
                                            <!-- Stage 6A.25: subtle Card Factory themed scrollbar, scoped to Team Performance only. -->
                                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CfTeamScrollBarStyle}" />
                                        </ScrollViewer.Resources>
                                        <ItemsControl ItemsSource="{Binding Operators}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="43.5" BorderBrush="{StaticResource CfLineSoft}" BorderThickness="0,0,0,1" Background="White">
                                                        <Grid Width="1182" Height="43.5">
                                                            <Grid.ColumnDefinitions>
                                                                <!-- Stage 6A.68: NAME widened so full names are visible. The width came
                                                                     from ABV, AUB and P&amp;L, which held ~87dip of empty space each. Total
                                                                     stays 1182 and the three baked label images were re-centred to match. -->
                                                                <ColumnDefinition Width="200" />
                                                                <ColumnDefinition Width="98" />
                                                                <ColumnDefinition Width="98" />
                                                                <ColumnDefinition Width="94" />
                                                                <ColumnDefinition Width="104" />
                                                                <ColumnDefinition Width="108" />
                                                                <ColumnDefinition Width="112" />
                                                                <ColumnDefinition Width="92" />
                                                                <ColumnDefinition Width="92" />
                                                                <ColumnDefinition Width="88" />
                                                                <ColumnDefinition Width="96" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBox Grid.Column="0" Width="178" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HtmlGridInputStyle}" FontWeight="Bold" />
                                                            <TextBox Grid.Column="1" Width="84" Text="{Binding SalesEntry, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HtmlGridInputStyle}" GotKeyboardFocus="NumericTextBox_GotKeyboardFocus" PreviewMouseLeftButtonDown="NumericTextBox_PreviewMouseLeftButtonDown" TextChanged="NumericTextBox_TextChanged" LostKeyboardFocus="NumericTextBox_LostKeyboardFocus" />
                                                            <TextBox Grid.Column="2" Width="66" MaxLength="2" Text="{Binding GiftCardQuantityEntry, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HtmlGridInputStyle}" GotKeyboardFocus="NumericTextBox_GotKeyboardFocus" PreviewMouseLeftButtonDown="NumericTextBox_PreviewMouseLeftButtonDown" TextChanged="NumericTextBox_TextChanged" LostKeyboardFocus="NumericTextBox_LostKeyboardFocus" />
                                                            <TextBox Grid.Column="3" Width="80" Text="{Binding GiftCardValueEntry, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HtmlGridInputStyle}" GotKeyboardFocus="NumericTextBox_GotKeyboardFocus" PreviewMouseLeftButtonDown="NumericTextBox_PreviewMouseLeftButtonDown" TextChanged="NumericTextBox_TextChanged" LostKeyboardFocus="NumericTextBox_LostKeyboardFocus" />
                                                            <Grid Grid.Column="4" Width="100" Height="43.5">
                                                                <TextBox Width="88" Text="{Binding TransactionsEntry, UpdateSourceTrigger=PropertyChanged}"
                                                                         GotKeyboardFocus="NumericTextBox_GotKeyboardFocus" PreviewMouseLeftButtonDown="NumericTextBox_PreviewMouseLeftButtonDown" TextChanged="NumericTextBox_TextChanged" LostKeyboardFocus="NumericTextBox_LostKeyboardFocus">
                                                                    <TextBox.Style>
                                                                        <!-- VerticalAlignment must live in the style, not as an attribute:
                                                                             a local value would beat the trigger below. -->
                                                                        <Style TargetType="TextBox" BasedOn="{StaticResource HtmlGridInputStyle}">
                                                                            <Setter Property="VerticalAlignment" Value="Center" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ShowTransactionsWarning}" Value="True">
                                                                                    <Setter Property="VerticalAlignment" Value="Top" />
                                                                                    <Setter Property="Margin" Value="0,2,0,0" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBox.Style>
                                                                </TextBox>
                                                                <!-- Stage 6A.70: the box used to be pinned to the top of the cell to leave
                                                                     room for the warning below, so it sat ~7px above every other box in the
                                                                     row even when the warning was hidden. It now centres like the rest and
                                                                     only lifts when the warning is actually shown. -->
                                                                <!-- Deep check 6: was the full sentence at 5.7px, too small to read. Now a short
                                                                     line at 9.5px that fits the 13px under the box; the whole
                                                                     sentence is in its tooltip. -->
                                                                <TextBlock Text="Needed for ABV/AUB"
                                                                           ToolTip="Enter transactions to calculate ABV and AUB"
                                                                           Foreground="#C53D46" FontFamily="Arial" FontSize="9.5" FontWeight="Bold"
                                                                           TextAlignment="Center" TextWrapping="NoWrap"
                                                                           Width="100" Margin="0,0,0,1" VerticalAlignment="Bottom" Visibility="Collapsed">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ShowTransactionsWarning}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                            <TextBox Grid.Column="5" Width="88" Text="{Binding UnitsEntry, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HtmlGridInputStyle}" GotKeyboardFocus="NumericTextBox_GotKeyboardFocus" PreviewMouseLeftButtonDown="NumericTextBox_PreviewMouseLeftButtonDown" TextChanged="NumericTextBox_TextChanged" LostKeyboardFocus="NumericTextBox_LostKeyboardFocus" />
                                                            <TextBlock Grid.Column="6" Text="{Binding CountedSales, StringFormat=£{0:N2}}" Style="{StaticResource HtmlMetricTextStyle}" />
                                                            <TextBlock Grid.Column="7" Text="{Binding Abv, StringFormat=£{0:N2}}" Tag="{Binding AbvState}" Style="{StaticResource HtmlMetricTextStyle}" />
                                                            <TextBlock Grid.Column="8" Text="{Binding Aub, StringFormat={}{0:N2}}" Tag="{Binding AubState}" Style="{StaticResource HtmlMetricTextStyle}" />
                                                            <TextBlock Grid.Column="9" Text="{Binding ProfitLossText}" Tag="{Binding ProfitLossState}" Style="{StaticResource HtmlMetricTextStyle}" />
                                                            <Button Grid.Column="10"
                                                                    Content="Remove"
                                                                    Style="{StaticResource HtmlRemoveButtonStyle}"
                                                                    Command="{Binding DataContext.RemoveOperatorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    IsTabStop="False" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!--
                                        Totals / Actual is isolated from the team-row grid. Separator lines live in
                                        their own rows, never behind the opaque HTML-rendered label artwork. This
                                        removes the short blue line fragments previously visible around the labels.
                                    -->
                                    <Border Height="2" Background="{StaticResource CfBlue}" />

                                    <Grid Height="43" Background="{StaticResource CfBlueSoft}" ClipToBounds="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="594" />
                                            <ColumnDefinition Width="108" />
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="96" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Stage 6B.67: live text in the app's Arial; these two were captured images in Baloo 2. -->
                                        <TextBlock Grid.Column="0" Text="Totals / Actual" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Sales +/-" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                        <Border Grid.Column="2" Style="{StaticResource HtmlTotalResultBoxStyle}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TotalSales, StringFormat=£{0:N2}}" Style="{StaticResource HtmlMetricTextStyle}" />
                                        </Border>
                                        <Border Grid.Column="3" Style="{StaticResource HtmlTotalResultBoxStyle}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ActualAbv, StringFormat=£{0:N2}}" Tag="{Binding AbvSummaryState}" Style="{StaticResource HtmlMetricTextStyle}" />
                                        </Border>
                                        <Border Grid.Column="4" Style="{StaticResource HtmlTotalResultBoxStyle}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ActualAub, StringFormat={}{0:N2}}" Tag="{Binding AubSummaryState}" Style="{StaticResource HtmlMetricTextStyle}" />
                                        </Border>
                                        <Border Grid.Column="5" Style="{StaticResource HtmlTotalResultBoxStyle}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TotalProfitLossText}" Tag="{Binding TotalProfitLossState}" Style="{StaticResource HtmlMetricTextStyle}" />
                                        </Border>
                                    </Grid>

                                </StackPanel>
                            </Border>

                            <!-- Stage 6B.64: Add person, design A - a slim outline pill in the app's own
                                 text, replacing the 122x40 bright-blue artwork. 28px tall; the 12px
                                 bottom margin keeps the row's old 40px so nothing below moves. -->
                            <Button x:Name="AddPersonButton" Height="28"
                                    Margin="28,7,0,12"
                                    HorizontalAlignment="Left"
                                    Cursor="Hand"
                                    FocusVisualStyle="{x:Null}"
                                    Command="{Binding AddOperatorCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="AddPersonPill" Background="White" BorderBrush="{StaticResource CfDeepBlue}"
                                                BorderThickness="1.5" CornerRadius="14" Padding="14,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="M6,1.5 L6,10.5 M1.5,6 L10.5,6" Stroke="{StaticResource CfDeepBlue}" StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" VerticalAlignment="Center" />
                                                <TextBlock Text="Add person" Margin="7,0,0,0" VerticalAlignment="Center"
                                                           FontFamily="Arial" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CfDeepBlue}" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="AddPersonPill" Property="Background" Value="#F5F9FF" /></Trigger>
                                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="AddPersonPill" Property="Background" Value="#E4EDF7" /></Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="AddPersonPill" Property="BorderBrush" Value="{StaticResource CfYellow}" /></Trigger>
                                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="AddPersonPill" Property="Opacity" Value="0.5" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                                </StackPanel>

                                <!-- Reports section (design C): totals in target-style tiles, then each person's
                                     voids, returns and no sales, highest first; values of £20 or more flagged.
                                     Same slot and height as Branch; the figures come from the Refunds, Voids &amp;
                                     No Sales report every Refresh already downloads. Staff discounts to follow. -->
                                <Grid x:Name="ReportsModePanel" Height="474" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="42"/>
                                        <RowDefinition Height="432"/>
                                    </Grid.RowDefinitions>

                                    <Canvas Grid.Row="0" Height="42" Width="1212" ClipToBounds="False">
                                        <Border Canvas.Left="28" Canvas.Top="0" Width="1184" Height="42"
                                                Background="{StaticResource CfBlue}" BorderBrush="{StaticResource CfYellow}"
                                                BorderThickness="3,3,3,0" CornerRadius="16,16,0,0">
                                            <TextBlock Text="Reports" Style="{StaticResource SectionTitleTextStyle}" />
                                        </Border>
                                        <Image Canvas.Left="-4" Canvas.Top="-12" Width="66" Height="66"
                                               Source="Assets/SectionSmiley.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Canvas>

                                    <Border Grid.Row="1" Width="1184" Height="432" Margin="28,0,0,0" HorizontalAlignment="Left"
                                            Background="White" BorderBrush="{StaticResource CfLine}" BorderThickness="1,0,1,1"
                                            CornerRadius="0,0,13,13" ClipToBounds="True">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="90"/>
                                                <RowDefinition Height="30"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="30"/>
                                            </Grid.RowDefinitions>

                                            <UniformGrid Grid.Row="0" Rows="1" Margin="14,14,0,14">
                                                    <Border Margin="0,0,14,0" Height="62" Background="White" BorderBrush="{StaticResource CfLine}" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                                                        <Grid>
                                                            <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                            <Border Background="{StaticResource CfBlueSoft}" CornerRadius="13,13,0,0">
                                                                <TextBlock Text="VOIDS" Margin="11,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource CfBlue}" FontFamily="Arial" FontSize="10" FontWeight="Bold" />
                                                            </Border>
                                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="11,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ReportVoidsValue, StringFormat=£{0:N2}}" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding ReportVoidsQuantity, StringFormat='{}{0} items'}" Margin="8,0,0,0" Foreground="{StaticResource CfMuted}" FontFamily="Arial" FontSize="10" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <Border Margin="0,0,14,0" Height="62" Background="White" BorderBrush="{StaticResource CfLine}" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                                                        <Grid>
                                                            <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                            <Border Background="{StaticResource CfBlueSoft}" CornerRadius="13,13,0,0">
                                                                <TextBlock Text="RETURNS" Margin="11,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource CfBlue}" FontFamily="Arial" FontSize="10" FontWeight="Bold" />
                                                            </Border>
                                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="11,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ReportRefundsValue, StringFormat=£{0:N2}}" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding ReportRefundsQuantity, StringFormat='{}{0} refunds'}" Margin="8,0,0,0" Foreground="{StaticResource CfMuted}" FontFamily="Arial" FontSize="10" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <Border Margin="0,0,14,0" Height="62" Background="White" BorderBrush="{StaticResource CfLine}" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                                                        <Grid>
                                                            <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                            <Border Background="{StaticResource CfBlueSoft}" CornerRadius="13,13,0,0">
                                                                <TextBlock Text="NO SALES" Margin="11,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource CfBlue}" FontFamily="Arial" FontSize="10" FontWeight="Bold" />
                                                            </Border>
                                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="11,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ReportNoSales}" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                                                                <TextBlock Text="drawer opens" Margin="8,0,0,0" Foreground="{StaticResource CfMuted}" FontFamily="Arial" FontSize="10" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <Border Margin="0,0,14,0" Height="62" Background="White" BorderBrush="{StaticResource CfLine}" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                                                        <Grid>
                                                            <Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                            <Border Background="{StaticResource CfBlueSoft}" CornerRadius="13,13,0,0">
                                                                <TextBlock Text="STAFF DISCOUNT" Margin="11,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource CfBlue}" FontFamily="Arial" FontSize="10" FontWeight="Bold" />
                                                            </Border>
                                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="11,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ReportStaffDiscountText}" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding ReportStaffDiscountDetail}" Margin="8,0,0,0" Foreground="{StaticResource CfMuted}" FontFamily="Arial" FontSize="10" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                            </UniformGrid>

                                            <Grid Grid.Row="1" Background="{StaticResource CfBlueSoft}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="NAME" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" Margin="14,0,0,0" HorizontalAlignment="Left" />
                                                <TextBlock Grid.Column="1" Text="VOIDS QTY" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="VOIDS VALUE" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="RETURNS QTY" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="RETURNS VALUE" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="5" Text="NO SALES" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="6" Text="STAFF DISCOUNT" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Grid>

                                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <!-- Deep check 4: the slim themed scrollbar, as on Team. -->
                                                <ScrollViewer.Resources>
                                                    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CfTeamScrollBarStyle}" />
                                                </ScrollViewer.Resources>
                                                <ItemsControl ItemsSource="{Binding ReportRows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Height="38">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                <Border Grid.ColumnSpan="7" BorderBrush="{StaticResource CfLineSoft}" BorderThickness="0,0,0,1"/>
                                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Margin="14,0,0,0" HorizontalAlignment="Left" Style="{StaticResource BranchMetricTextStyle}" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding VoidsQuantity}" Style="{StaticResource BranchMetricTextStyle}"/>
                                                                <Border Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,3" CornerRadius="8">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="Transparent"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding VoidsFlagged}" Value="True"><Setter Property="Background" Value="#FFF1DC"/></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding VoidsValue, StringFormat=£{0:N2}}">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BranchMetricTextStyle}">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding VoidsFlagged}" Value="True"><Setter Property="Foreground" Value="#9A5B00"/></DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                                <TextBlock Grid.Column="3" Text="{Binding RefundsQuantity}" Style="{StaticResource BranchMetricTextStyle}"/>
                                                                <Border Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,3" CornerRadius="8">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="Transparent"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding RefundsFlagged}" Value="True"><Setter Property="Background" Value="#FFF1DC"/></DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="{Binding RefundsValue, StringFormat=£{0:N2}}">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BranchMetricTextStyle}">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding RefundsFlagged}" Value="True"><Setter Property="Foreground" Value="#9A5B00"/></DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                                <TextBlock Grid.Column="5" Text="{Binding NoSales}" Style="{StaticResource BranchMetricTextStyle}"/>
                                                                <TextBlock Grid.Column="6" Text="{Binding StaffDiscount}" Style="{StaticResource BranchMetricTextStyle}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                            <TextBlock Grid.Row="2" Text="Press Generate reports to load voids, returns, no sales and staff discounts for this date."
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{StaticResource CfMuted}" FontFamily="Arial" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasReportData}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                                <Border Background="#FFF1DC" CornerRadius="7" Padding="7,2">
                                                    <TextBlock Text="£20.00+" Foreground="#9A5B00" FontFamily="Arial" FontSize="9.5" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Text="highlighted to look into · voids include transaction and line voids" Margin="6,0,0,0"
                                                           Foreground="{StaticResource CfMuted}" FontFamily="Arial" FontSize="9.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Branch view overlays the Team slot and is intentionally the same one-person height.
                                     TeamModePanel remains Hidden (not Collapsed) while Branch is active, preserving the exact 6A.24 resize behaviour and all team data. -->
                                <Grid x:Name="BranchModePanel" Height="474" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="42"/>
                                        <RowDefinition Height="432"/>
                                    </Grid.RowDefinitions>

                                    <Canvas Grid.Row="0" Height="42" Width="1212" ClipToBounds="False">
                                        <Border Canvas.Left="28" Canvas.Top="0" Width="1184" Height="42"
                                                Background="{StaticResource CfBlue}"
                                                BorderBrush="{StaticResource CfYellow}"
                                                BorderThickness="3,3,3,0"
                                                CornerRadius="16,16,0,0">
                                            <!-- Stage 6B.47: the same title treatment as Team Performance - centred,
                                                 in the same font (Chewy) at the same height, instead of left-aligned
                                                 Arial and a FLOOID REPORT tag. Real text since v1.3.0 (SectionTitleTextStyle). -->
                                            <TextBlock Text="Branch Performance" Style="{StaticResource SectionTitleTextStyle}" />
                                        </Border>
                                        <Image Canvas.Left="-4" Canvas.Top="-12" Width="66" Height="66"
                                               Source="Assets/SectionSmiley.png" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Canvas>

                                    <Border Grid.Row="1" Width="1184" Height="432" Margin="28,0,0,0" HorizontalAlignment="Left"
                                            Background="White" BorderBrush="{StaticResource CfLine}" BorderThickness="1,0,1,1"
                                            CornerRadius="0,0,13,13" ClipToBounds="True">
                                        <Grid Width="1182">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="43"/>
                                                <RowDefinition Height="0"/>
                                                <RowDefinition Height="345"/>
                                                <RowDefinition Height="44"/>
                                            </Grid.RowDefinitions>

                                            <!-- One uncluttered navigation/status line. -->
                                            <Grid Grid.Row="0" Background="#FBFDFF" Margin="12,6,12,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Stage 6B.67 (B1): the split card used by Day / Range and Fast / Safe. -->
                                                <Border Width="220" Height="30" VerticalAlignment="Center" Background="White"
                                                        BorderBrush="{StaticResource CfLine}" BorderThickness="1" CornerRadius="10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button x:Name="BranchHourlyTabButton" Grid.Column="0" Content="Performance" Tag="Active"
                                                                Style="{StaticResource BranchSplitLeftStyle}" Click="BranchHourlyTab_Click"/>
                                                        <Border Grid.Column="1" Background="{StaticResource CfLine}" />
                                                        <Button x:Name="BranchGiftCardsTabButton" Grid.Column="2" Content="Gift Cards"
                                                                Style="{StaticResource BranchSplitRightStyle}" Click="BranchGiftCardsTab_Click"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <!-- Stage 6B.11: the separator went with the status text it used to
                                                         divide. Last updated stays - it answers "how old are these
                                                         figures", which the overlay cannot, since the overlay is only
                                                         on screen while a retrieval is running. -->
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource CfBlue}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding FlooidLastUpdatedText}" Foreground="{StaticResource CfMuted}" FontFamily="Arial" FontSize="9.5"/>
                                                </StackPanel>
                                                <!-- Stage 6B.01: moved to the target row beside PERIOD. -->
                                            </Grid>

                                            <!-- Stage 6B.44: the totals strip that sat here was removed - it repeated
                                                 the Branch Total bar. Row 1 is kept at 0 so row numbers are unchanged;
                                                 its 52px went to the Branch Total bar (row 3). -->

                                            <!-- Large Performance table: about eight rows visible before scrolling. -->
                                            <Grid x:Name="BranchHourlyPanel" Grid.Row="2" Margin="12,0,12,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="29"/>
                                                    <RowDefinition Height="316"/>
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" Background="{StaticResource CfBlueSoft}" BorderBrush="{StaticResource CfLine}" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="150"/><ColumnDefinition Width="170"/><ColumnDefinition Width="180"/>
                                                            <ColumnDefinition Width="150"/><ColumnDefinition Width="160"/><ColumnDefinition Width="160"/>
                                                            <ColumnDefinition Width="196"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="TIME" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="SALES" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="TRANSACTIONS" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="3" Text="UNITS" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="4" Text="AUB" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="5" Text="ABV" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="6" Text="% SALES" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <Border Grid.Row="1" BorderBrush="{StaticResource CfLine}" BorderThickness="1,0,1,1" CornerRadius="0,0,8,8" ClipToBounds="True">
                                                    <Grid>
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                                                            <ScrollViewer.Resources>
                                                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CfTeamScrollBarStyle}"/>
                                                            </ScrollViewer.Resources>
                                                            <ItemsControl ItemsSource="{Binding BranchHours}">
                                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Height="34" BorderBrush="{StaticResource CfLineSoft}" BorderThickness="0,0,0,1">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Background" Value="White"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsStrongestHour}" Value="True">
                                                                                            <Setter Property="Background" Value="#FFF6C7"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="150"/><ColumnDefinition Width="170"/><ColumnDefinition Width="180"/>
                                                                                    <ColumnDefinition Width="150"/><ColumnDefinition Width="160"/><ColumnDefinition Width="160"/>
                                                                                    <ColumnDefinition Width="196"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Grid.Column="0" Text="{Binding TimeBand}" Style="{StaticResource BranchMetricTextStyle}" FontWeight="Bold"/>
                                                                                <TextBlock Grid.Column="1" Text="{Binding Sales, StringFormat=£{0:N2}}" Style="{StaticResource BranchMetricTextStyle}"/>
                                                                                <TextBlock Grid.Column="2" Text="{Binding Transactions}" Style="{StaticResource BranchMetricTextStyle}"/>
                                                                                <TextBlock Grid.Column="3" Text="{Binding Units}" Style="{StaticResource BranchMetricTextStyle}"/>
                                                                                <TextBlock Grid.Column="4" Text="{Binding Aub, StringFormat={}{0:N2}}" Style="{StaticResource BranchMetricTextStyle}"/>
                                                                                <TextBlock Grid.Column="5" Text="{Binding Abv, StringFormat=£{0:N2}}" Style="{StaticResource BranchMetricTextStyle}"/>
                                                                                <!-- % Sales with a bar (design 5A): blue, the busiest hour yellow. -->
                                                                                <Grid Grid.Column="6" Margin="14,0,10,0">
                                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                                                                    <Border Height="8" CornerRadius="4" Background="#EEF3FA" VerticalAlignment="Center">
                                                                                        <Border CornerRadius="4" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                                                                            <Border.RenderTransform><ScaleTransform ScaleX="{Binding BarFraction}" /></Border.RenderTransform>
                                                                                            <Border.Style>
                                                                                                <Style TargetType="Border">
                                                                                                    <Setter Property="Background" Value="#7FA6DD"/>
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding IsStrongestHour}" Value="True"><Setter Property="Background" Value="{StaticResource CfYellow}"/></DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </Border.Style>
                                                                                        </Border>
                                                                                    </Border>
                                                                                    <TextBlock Grid.Column="1" Text="{Binding PercentOfSales, StringFormat={}{0:N1}%}" Style="{StaticResource BranchMetricTextStyle}" HorizontalAlignment="Right"/>
                                                                                </Grid>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                        <TextBlock Text="{Binding BranchDataMessage}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="#B33A46" FontFamily="Arial" FontSize="10" FontWeight="Bold" IsHitTestVisible="False">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </Grid>

                                            <!-- Gift Cards use the same large table area. -->
                                            <Grid x:Name="BranchGiftCardsPanel" Grid.Row="2" Margin="12,0,12,0" Visibility="Hidden">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="29"/>
                                                    <RowDefinition Height="316"/>
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" Background="{StaticResource CfBlueSoft}" BorderBrush="{StaticResource CfLine}" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170"/><ColumnDefinition Width="210"/><ColumnDefinition Width="440"/>
                                                            <ColumnDefinition Width="250"/><ColumnDefinition Width="96"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="GIFT CARD QTY" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="GIFT CARD SALES" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="CARD / ITEM" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="3" Text="OPERATOR" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                    </Grid>
                                                </Border>
                                                <Border Grid.Row="1" BorderBrush="{StaticResource CfLine}" BorderThickness="1,0,1,1" CornerRadius="0,0,8,8" ClipToBounds="True">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                                                        <ScrollViewer.Resources>
                                                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CfTeamScrollBarStyle}"/>
                                                        </ScrollViewer.Resources>
                                                        <ItemsControl ItemsSource="{Binding BranchGiftCards}">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Height="38" Background="White" BorderBrush="{StaticResource CfLineSoft}" BorderThickness="0,0,0,1">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="170"/><ColumnDefinition Width="210"/><ColumnDefinition Width="440"/>
                                                                                <ColumnDefinition Width="250"/><ColumnDefinition Width="96"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="{Binding Quantity}" Style="{StaticResource BranchMetricTextStyle}"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding Sales, StringFormat=£{0:N2}}" Style="{StaticResource BranchMetricTextStyle}"/>
                                                                            <TextBlock Grid.Column="2" Text="{Binding Item}" Style="{StaticResource BranchMetricTextStyle}" TextTrimming="CharacterEllipsis"/>
                                                                            <TextBlock Grid.Column="3" Text="{Binding OperatorName}" Style="{StaticResource BranchMetricTextStyle}" TextTrimming="CharacterEllipsis"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Border>
                                            </Grid>

                                            <!-- Stage 6A.78: the Branch Total footer now matches the formula strip
                                                 at the bottom of the dashboard - same pale yellow, the same 1px
                                                 #F2D46B border, the same 12px radius and the same 4px yellow left
                                                 accent. It is inset 12px each side like the totals strip above it,
                                                 so the rounded corners are visible instead of being clipped flat
                                                 against the panel edge. -->
                                            <Border Grid.Row="3" Margin="12,0,12,6"
                                                    Background="{StaticResource CfBlueSoft}"
                                                    BorderBrush="{StaticResource CfLine}"
                                                    BorderThickness="1"
                                                    CornerRadius="12">
                                                <!-- Stage 6B.44 (concept B): five headline totals, gift cards to the right of a
                                                     divider. Stage 6B.53 (shorter option 2): one line - each label beside its
                                                     value - in a 38px bar; values 14 / labels 8.5, gift cards 12 / 8. -->
                                                <Grid Margin="0,0,13,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="1"/><ColumnDefinition Width="230"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="4" Background="{StaticResource CfDeepBlue}" CornerRadius="12,0,0,12" HorizontalAlignment="Left" />
                                                    <TextBlock Grid.Column="0" Text="BRANCH TOTAL" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="22,0,0,0"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="SALES" FontSize="9.5" Foreground="{StaticResource CfMuted}" FontFamily="Arial" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Text="{Binding BranchTotalSales, StringFormat=£{0:N2}}" FontSize="14" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/></StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="TRANSACTIONS" FontSize="9.5" Foreground="{StaticResource CfMuted}" FontFamily="Arial" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Text="{Binding BranchTotalTransactions}" FontSize="14" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/></StackPanel>
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="UNITS" FontSize="9.5" Foreground="{StaticResource CfMuted}" FontFamily="Arial" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Text="{Binding BranchTotalUnits}" FontSize="14" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/></StackPanel>
                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="AUB" FontSize="9.5" Foreground="{StaticResource CfMuted}" FontFamily="Arial" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Text="{Binding BranchActualAub, StringFormat={}{0:N2}}" FontSize="14" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/></StackPanel>
                                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="ABV" FontSize="9.5" Foreground="{StaticResource CfMuted}" FontFamily="Arial" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Text="{Binding BranchActualAbv, StringFormat=£{0:N2}}" FontSize="14" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/></StackPanel>
                                                    <Border Grid.Column="6" Background="{StaticResource CfLine}" Height="23" VerticalAlignment="Center"/>
                                                    <Grid Grid.Column="7">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="GIFT QTY" FontSize="9.5" Foreground="{StaticResource CfMuted}" FontFamily="Arial" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Text="{Binding BranchGiftCardQuantity}" FontSize="12" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/></StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="GIFT SALES" FontSize="9.5" Foreground="{StaticResource CfMuted}" FontFamily="Arial" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Text="{Binding BranchGiftCardSales, StringFormat=£{0:N2}}" FontSize="12" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/></StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </StackPanel>

                        <!-- PERFORMANCE SUMMARY: accepted 28px inset + 66px smiley geometry. -->
                        <StackPanel x:Name="PerformanceSummarySection" Margin="0,12,0,0">
                            <Canvas Height="40" Width="1212" ClipToBounds="False">
                                <Border Canvas.Left="28" Canvas.Top="0" Width="1184" Height="40"
                                        Background="{StaticResource CfBlue}"
                                        BorderBrush="{StaticResource CfYellow}"
                                        BorderThickness="3,3,3,0"
                                        CornerRadius="16,16,0,0">
                                    <TextBlock Text="Targets" Style="{StaticResource SectionTitleTextStyle}" />
                                </Border>
                                <Image Canvas.Left="-4" Canvas.Top="-13"
                                       Width="66" Height="66"
                                       Source="Assets/SectionSmiley.png"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       SnapsToDevicePixels="False" />
                            </Canvas>

                            <Grid Width="1184" Height="77.5" Margin="28,0,0,0" HorizontalAlignment="Left">
                                <!-- Stage 6B.67: drawn live instead of the captured SummaryGridStaticExact image -
                                     same colours (sampled from it), lines and labels, in the app's Arial. -->
                                <Border Background="#FBFCFD" BorderBrush="{StaticResource CfLine}" BorderThickness="1,0,1,1" CornerRadius="0,0,13,13">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="30.5"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border Grid.Row="0" Grid.ColumnSpan="3" BorderBrush="{StaticResource CfLine}" BorderThickness="0,0,0,1" />
                                        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" BorderBrush="{StaticResource CfLine}" BorderThickness="1,0,1,0" />
                                        <TextBlock Grid.Column="0" Text="SALES (£)" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="ABV (£)" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="AUB" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="TARGET" Foreground="{StaticResource CfBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Border Width="122" Height="30" Background="White" BorderBrush="#CFDAE8" BorderThickness="1" CornerRadius="10">
                                            <TextBox Height="26" Margin="1,0" VerticalAlignment="Center"
                                                     Text="{Binding SalesTarget, Converter={StaticResource ZeroBlankDecimalConverter}, UpdateSourceTrigger=PropertyChanged}"
                                                     Tag="Enter target"
                                                     Style="{StaticResource HtmlTargetTextBoxStyle}"
                                                     FontSize="14"
                                                     GotKeyboardFocus="NumericTextBox_GotKeyboardFocus"
                                                     PreviewMouseLeftButtonDown="NumericTextBox_PreviewMouseLeftButtonDown"
                                                     TextChanged="NumericTextBox_TextChanged"
                                                     LostKeyboardFocus="NumericTextBox_LostKeyboardFocus" />
                                        </Border>
                                        <TextBlock Text="{Binding SalesSummaryText}" Tag="{Binding SalesVarianceState}" Style="{StaticResource HtmlMetricTextStyle}" FontSize="13" MinWidth="80" Margin="14,0,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="TARGET" Foreground="{StaticResource CfBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Border Width="122" Height="30" Background="White" BorderBrush="#CFDAE8" BorderThickness="1" CornerRadius="10">
                                            <TextBox Height="26" Margin="1,0" VerticalAlignment="Center"
                                                     Text="{Binding AbvTarget, Converter={StaticResource ZeroBlankDecimalConverter}, UpdateSourceTrigger=PropertyChanged}"
                                                     Tag="Enter target"
                                                     Style="{StaticResource HtmlTargetTextBoxStyle}"
                                                     FontSize="14"
                                                     GotKeyboardFocus="NumericTextBox_GotKeyboardFocus"
                                                     PreviewMouseLeftButtonDown="NumericTextBox_PreviewMouseLeftButtonDown"
                                                     TextChanged="NumericTextBox_TextChanged"
                                                     LostKeyboardFocus="NumericTextBox_LostKeyboardFocus" />
                                        </Border>
                                        <TextBlock Text="{Binding AbvSummaryText}" Tag="{Binding AbvSummaryState}" Style="{StaticResource HtmlMetricTextStyle}" FontSize="13" MinWidth="80" Margin="14,0,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="TARGET" Foreground="{StaticResource CfBlue}" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Border Width="122" Height="30" Background="White" BorderBrush="#CFDAE8" BorderThickness="1" CornerRadius="10">
                                            <TextBox Height="26" Margin="1,0" VerticalAlignment="Center"
                                                     Text="{Binding AubTarget, Converter={StaticResource ZeroBlankDecimalConverter}, UpdateSourceTrigger=PropertyChanged}"
                                                     Tag="Enter target"
                                                     Style="{StaticResource HtmlTargetTextBoxStyle}"
                                                     FontSize="14"
                                                     GotKeyboardFocus="NumericTextBox_GotKeyboardFocus"
                                                     PreviewMouseLeftButtonDown="NumericTextBox_PreviewMouseLeftButtonDown"
                                                     TextChanged="NumericTextBox_TextChanged"
                                                     LostKeyboardFocus="NumericTextBox_LostKeyboardFocus" />
                                        </Border>
                                        <TextBlock Text="{Binding AubSummaryText}" Tag="{Binding AubSummaryState}" Style="{StaticResource HtmlMetricTextStyle}" FontSize="13" MinWidth="80" Margin="14,0,0,0" />
                                    </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                            <TextBlock Height="14" Margin="28,10,0,0" Foreground="{StaticResource CfMuted}" FontFamily="Arial" FontSize="9.5">
                                <Run Text="Hover the" /> <Run Text="i" FontWeight="Bold" Foreground="{StaticResource CfBlue}" /> <Run Text="on Counted Sales, ABV, AUB or P&amp;L to see how it is worked out." />
                            </TextBlock>
                        </StackPanel>

                        <!-- Stage 6A.28: preserve the pre-6A.27 window/dashboard height without restoring the Calculate button.
                             Hidden reserves the exact old 40px control slot and its margins while remaining non-interactive. -->
                        <Border x:Name="CalculateSpacer"
                                Width="122"
                                Height="96"
                                Margin="28,12,0,0"
                                HorizontalAlignment="Left"
                                Visibility="Hidden"
                                IsHitTestVisible="False" />

                        <!-- Stage 6A.27: calculations update automatically as values are edited. -->

                    </StackPanel>
                </Border>
        </Viewbox>

        <!-- Menu design P3 (owner, 14 Oct): the dialogs' navy band across the top with the
             store and the version state, three tabs down the left (Daily Briefing, Save &
             Share, Settings) and only the open tab's items on the right. Every item keeps
             its handler; the names and the grey line under each were agreed with the owner. -->
        <Popup x:Name="MainMenuPopup"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               VerticalOffset="10"
               HorizontalOffset="-452">
            <Popup.Resources>
                <!-- A tab on the left: pale blue when open (Tag="Active"). The icon follows the text colour. -->
                <Style x:Key="MenuTabStyle" TargetType="Button">
                    <Setter Property="Foreground" Value="#4A5D78" />
                    <Setter Property="FontFamily" Value="Arial" />
                    <Setter Property="FontSize" Value="11.5" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Height" Value="36" />
                    <Setter Property="Margin" Value="0,0,0,2" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Tab" Background="Transparent" CornerRadius="9" Padding="10,0">
                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="#F1F6FC" /></Trigger>
                                    <Trigger Property="Tag" Value="Active">
                                        <Setter TargetName="Tab" Property="Background" Value="{StaticResource CfBlueSoft}" />
                                        <Setter Property="Foreground" Value="{StaticResource CfDeepBlue}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style x:Key="MenuTabIconStyle" TargetType="Path">
                    <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <Setter Property="StrokeThickness" Value="1.6" />
                    <Setter Property="StrokeLineJoin" Value="Round" />
                    <Setter Property="StrokeStartLineCap" Value="Round" />
                    <Setter Property="StrokeEndLineCap" Value="Round" />
                    <Setter Property="Width" Value="15" />
                    <Setter Property="Height" Value="15" />
                    <Setter Property="Stretch" Value="Uniform" />
                    <Setter Property="Margin" Value="0,0,9,0" />
                </Style>
                <!-- An item on the right: icon, name, grey line, and a chevron or control at the end. -->
                <Style x:Key="MenuItemIconStyle" TargetType="Path">
                    <Setter Property="Stroke" Value="{StaticResource CfDeepBlue}" />
                    <Setter Property="StrokeThickness" Value="1.6" />
                    <Setter Property="StrokeLineJoin" Value="Round" />
                    <Setter Property="StrokeStartLineCap" Value="Round" />
                    <Setter Property="StrokeEndLineCap" Value="Round" />
                    <Setter Property="Width" Value="16" />
                    <Setter Property="Height" Value="16" />
                    <Setter Property="Stretch" Value="Uniform" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="0,0,12,0" />
                </Style>
                <Style x:Key="MenuItemNameStyle" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Arial" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Foreground" Value="{StaticResource CfInk}" />
                </Style>
                <Style x:Key="MenuItemNoteStyle" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Arial" />
                    <Setter Property="FontSize" Value="9.5" />
                    <Setter Property="Foreground" Value="#8A99AD" />
                    <Setter Property="Margin" Value="0,2,0,0" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
                <Style x:Key="MenuChevronStyle" TargetType="Path">
                    <Setter Property="Data" Value="M8,5 L13,10 L8,15" />
                    <Setter Property="Stroke" Value="#A5C0DD" />
                    <Setter Property="StrokeThickness" Value="1.6" />
                    <Setter Property="StrokeStartLineCap" Value="Round" />
                    <Setter Property="StrokeEndLineCap" Value="Round" />
                    <Setter Property="Width" Value="12" />
                    <Setter Property="Height" Value="12" />
                    <Setter Property="Stretch" Value="Uniform" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style x:Key="MenuItemRowStyle" TargetType="Border">
                    <Setter Property="BorderBrush" Value="#F0F3F8" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                </Style>
                <Style x:Key="MenuPaneTitleStyle" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{StaticResource CfTitleFont}" />
                    <Setter Property="FontSize" Value="22" />
                    <Setter Property="Foreground" Value="{StaticResource CfDeepBlue}" />
                </Style>
                <Style x:Key="MenuPaneSubtitleStyle" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Arial" />
                    <Setter Property="FontSize" Value="10.5" />
                    <Setter Property="Foreground" Value="{StaticResource CfMuted}" />
                    <Setter Property="Margin" Value="0,1,0,10" />
                </Style>
            </Popup.Resources>
            <Border Width="520"
                    Background="White"
                    BorderBrush="#D6E2EF"
                    BorderThickness="1"
                    CornerRadius="18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.18" Color="#183153" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Navy band: title, store, and the version chip's state as a pill. -->
                    <Border Background="{StaticResource CfDeepBlue}" CornerRadius="17,17,0,0" Padding="18,11,16,11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Menu" FontFamily="{StaticResource CfTitleFont}" FontSize="23" Foreground="White" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding HeaderStoreText}" Foreground="#D6E4F5" FontFamily="Arial" FontSize="10"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="16,0,10,0" />
                            <Border x:Name="MenuVersionPill" Grid.Column="2" CornerRadius="9" Padding="8,3" Background="#EAF7EF" VerticalAlignment="Center">
                                <TextBlock x:Name="MenuVersionText" FontFamily="Arial" FontSize="9.5" FontWeight="Bold" Foreground="#0B7A35" />
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" MinHeight="272">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Tabs -->
                        <Border BorderBrush="#EDF1F6" BorderThickness="0,0,1,0">
                            <StackPanel Margin="8,10,8,10">
                                <Button x:Name="MenuTabBriefing" Style="{StaticResource MenuTabStyle}" Tag="Active" Click="MenuTab_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M5,3 L15,3 L15,17 L5,17 Z M8,7 L12,7 M8,10 L12,10 M8,13 L10.5,13" Style="{StaticResource MenuTabIconStyle}" />
                                        <TextBlock Text="Daily Briefing" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="MenuTabShare" Style="{StaticResource MenuTabStyle}" Click="MenuTab_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M3,6 L8,6 L10,8 L17,8 L17,16 L3,16 Z" Style="{StaticResource MenuTabIconStyle}" />
                                        <TextBlock Text="Save &amp; Share" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="MenuTabSettings" Style="{StaticResource MenuTabStyle}" Click="MenuTab_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M13,10 A3,3 0 1 1 7,10 A3,3 0 1 1 13,10 Z M10,2 L10,4 M10,16 L10,18 M2,10 L4,10 M16,10 L18,10 M4.3,4.3 L5.7,5.7 M14.3,14.3 L15.7,15.7 M4.3,15.7 L5.7,14.3 M14.3,5.7 L15.7,4.3" Style="{StaticResource MenuTabIconStyle}" />
                                        <TextBlock Text="Settings" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Daily Briefing -->
                        <StackPanel x:Name="MenuPaneBriefing" Grid.Column="1" Margin="18,14,18,14">
                            <TextBlock Text="Daily Briefing" Style="{StaticResource MenuPaneTitleStyle}" />
                            <TextBlock Text="The store's sheet, filled in from Flooid." Style="{StaticResource MenuPaneSubtitleStyle}" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#F4F7FB" CornerRadius="9" Padding="9,7">
                                    <StackPanel>
                                        <TextBlock Text="Day" FontFamily="Arial" FontSize="9.5" Foreground="{StaticResource CfMuted}" />
                                        <TextBlock x:Name="DailyBriefingDayText" FontFamily="Arial" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource CfDeepBlue}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="#F4F7FB" CornerRadius="9" Padding="9,7">
                                    <StackPanel>
                                        <TextBlock Text="Pulls" FontFamily="Arial" FontSize="9.5" Foreground="{StaticResource CfMuted}" />
                                        <TextBlock Text="Team · Branch · Gift · Discounts" FontFamily="Arial" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource CfDeepBlue}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Button x:Name="DailyBriefingExportButton" Height="40" Cursor="Hand" Click="ExportDailyBriefing_Click"
                                    ToolTip="Pull every report for the day and fill in the Daily Briefing">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="B" Background="{StaticResource CfYellow}" BorderBrush="#E0AC00" BorderThickness="1" CornerRadius="11">
                                            <TextBlock Text="Export to Daily Briefing" FontFamily="Arial" FontSize="12.5" FontWeight="Bold"
                                                       Foreground="{StaticResource CfDeepBlue}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#FFD53D" /></Trigger>
                                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#F2BC00" /></Trigger>
                                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.45" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <TextBlock x:Name="DailyBriefingNote" Text="Opens a preview to print or save as PDF"
                                       FontFamily="Arial" FontSize="9.5" Foreground="#8A99AD" Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Save & Share -->
                        <StackPanel x:Name="MenuPaneShare" Grid.Column="1" Margin="18,14,18,14" Visibility="Collapsed">
                            <TextBlock Text="Save &amp; Share" Style="{StaticResource MenuPaneTitleStyle}" />
                            <TextBlock Text="Keep this day, open another, or pass it on." Style="{StaticResource MenuPaneSubtitleStyle}" />
                            <Border Style="{StaticResource MenuItemRowStyle}">
                                <Button Style="{StaticResource MenuRowButtonStyle}" Height="42" Click="LoadFile_Click">
                                    <Grid Width="300">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Path Data="M3,6 L8,6 L10,8 L17,8 L17,16 L3,16 Z" Style="{StaticResource MenuItemIconStyle}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Open a saved day" Style="{StaticResource MenuItemNameStyle}" />
                                            <TextBlock Text="A .cfpl file you saved earlier" Style="{StaticResource MenuItemNoteStyle}" />
                                        </StackPanel>
                                        <Path Grid.Column="2" Style="{StaticResource MenuChevronStyle}" />
                                    </Grid>
                                </Button>
                            </Border>
                            <Border Style="{StaticResource MenuItemRowStyle}">
                                <Button Style="{StaticResource MenuRowButtonStyle}" Height="42" Click="SaveFile_Click">
                                    <Grid Width="300">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Path Data="M4,3 L14,3 L17,6 L17,17 L4,17 Z M7,3 L7,8 L13,8 L13,3 M7,17 L7,12 L14,12 L14,17" Style="{StaticResource MenuItemIconStyle}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Save this day" Style="{StaticResource MenuItemNameStyle}" />
                                            <TextBlock Text="As a .cfpl file, to open later or on another till" Style="{StaticResource MenuItemNoteStyle}" />
                                        </StackPanel>
                                        <Path Grid.Column="2" Style="{StaticResource MenuChevronStyle}" />
                                    </Grid>
                                </Button>
                            </Border>
                            <Border Style="{StaticResource MenuItemRowStyle}">
                                <Button Style="{StaticResource MenuRowButtonStyle}" Height="42" Click="ExportReport_Click">
                                    <Grid Width="300">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Path Data="M10,3 L10,12 M6,7 L10,3 L14,7 M4,13 L4,17 L16,17 L16,13" Style="{StaticResource MenuItemIconStyle}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Export as a web page" Style="{StaticResource MenuItemNameStyle}" />
                                            <TextBlock Text="To email or keep; opens in any browser" Style="{StaticResource MenuItemNoteStyle}" />
                                        </StackPanel>
                                        <Path Grid.Column="2" Style="{StaticResource MenuChevronStyle}" />
                                    </Grid>
                                </Button>
                            </Border>
                            <Button Style="{StaticResource MenuRowButtonStyle}" Height="42" Click="PrintReport_Click">
                                <Grid Width="300">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Path Data="M6,8 L6,3 L14,3 L14,8 M4,8 L16,8 L16,14 L4,14 Z M6,12 L14,12 L14,17 L6,17 Z" Style="{StaticResource MenuItemIconStyle}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Print summary" Style="{StaticResource MenuItemNameStyle}" />
                                        <TextBlock Text="Team, Branch and Reports on paper" Style="{StaticResource MenuItemNoteStyle}" />
                                    </StackPanel>
                                    <Path Grid.Column="2" Style="{StaticResource MenuChevronStyle}" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <!-- Settings -->
                        <StackPanel x:Name="MenuPaneSettings" Grid.Column="1" Margin="18,14,18,14" Visibility="Collapsed">
                            <TextBlock Text="Settings" Style="{StaticResource MenuPaneTitleStyle}" />
                            <TextBlock Text="How the app works with Flooid." Style="{StaticResource MenuPaneSubtitleStyle}" />
                            <Border Style="{StaticResource MenuItemRowStyle}" Padding="12,0" Height="46">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Path Data="M3,15 A7,7 0 1 1 17,15 M10,15 L13,9" Style="{StaticResource MenuItemIconStyle}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="Flooid speed" Style="{StaticResource MenuItemNameStyle}" />
                                        <!-- Set in code from the speed in force. -->
                                        <TextBlock x:Name="RetrievalSpeedHint" Style="{StaticResource MenuItemNoteStyle}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Width="112" Height="28" Background="White" BorderBrush="{StaticResource CfLine}"
                                            BorderThickness="1" CornerRadius="9" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="1" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <RadioButton x:Name="SpeedFastOption" Grid.Column="0" Content="Fast" GroupName="RetrievalSpeed" FontSize="10.5"
                                                         Style="{StaticResource ModeCardSegmentStyle}" Checked="RetrievalSpeed_Changed">
                                                <RadioButton.Tag><CornerRadius>8,0,0,8</CornerRadius></RadioButton.Tag>
                                            </RadioButton>
                                            <Border Grid.Column="1" Background="{StaticResource CfLine}" />
                                            <RadioButton x:Name="SpeedSafeOption" Grid.Column="2" Content="Safe" GroupName="RetrievalSpeed" FontSize="10.5"
                                                         Style="{StaticResource ModeCardSegmentStyle}" Checked="RetrievalSpeed_Changed">
                                                <RadioButton.Tag><CornerRadius>0,8,8,0</CornerRadius></RadioButton.Tag>
                                            </RadioButton>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource MenuItemRowStyle}">
                                <Button Style="{StaticResource MenuRowButtonStyle}" Height="42" Click="PreferencesMenu_Click">
                                    <Grid Width="300">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Path Data="M3,9 L10,3 L17,9 L17,17 L3,17 Z M8,17 L8,12 L12,12 L12,17" Style="{StaticResource MenuItemIconStyle}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Store &amp; defaults" Style="{StaticResource MenuItemNameStyle}" />
                                            <TextBlock Text="Store name, and reset the app's settings" Style="{StaticResource MenuItemNoteStyle}" />
                                        </StackPanel>
                                        <Path Grid.Column="2" Style="{StaticResource MenuChevronStyle}" />
                                    </Grid>
                                </Button>
                            </Border>
                            <Border Style="{StaticResource MenuItemRowStyle}">
                                <Button Style="{StaticResource MenuRowButtonStyle}" Height="42" Click="CheckForUpdatesMenu_Click">
                                    <Grid Width="300">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <Path Data="M20,11 A8.1,8.1 0 0 0 4.5,9 M4,5 V9 H8 M4,13 A8.1,8.1 0 0 0 19.5,15 M20,19 V15 H16" Style="{StaticResource MenuItemIconStyle}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Check for updates" Style="{StaticResource MenuItemNameStyle}" />
                                            <TextBlock x:Name="CheckForUpdatesDetail" Style="{StaticResource MenuItemNoteStyle}" />
                                        </StackPanel>
                                        <Path Grid.Column="2" Style="{StaticResource MenuChevronStyle}" />
                                    </Grid>
                                </Button>
                            </Border>
                            <Button Style="{StaticResource MenuRowButtonStyle}" Height="42" Click="ClearFigures_Click">
                                <Grid Width="300">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Path Data="M4,6 L16,6 M8,6 L8,4 L12,4 L12,6 M6,6 L7,17 L13,17 L14,6" Style="{StaticResource MenuItemIconStyle}" Stroke="#B03A3A" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Start fresh" Style="{StaticResource MenuItemNameStyle}" Foreground="#B03A3A" />
                                        <TextBlock Text="Empties every section · can't be undone" Style="{StaticResource MenuItemNoteStyle}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Popup>

            </Grid>

            <!-- Stage 6B.11: retrieval overlay, concept BC. A grab takes about twelve
                 seconds, which is long enough that a bare spinner starts to look stuck.
                 The three phases are already named and timed, so the overlay names them
                 too: a hang is visible as the step it hangs on. It also blocks the page,
                 which is wanted - the figures underneath are mid-update, and a second
                 Refresh during a grab is the re-entrancy _flooidGrabBusy exists to stop.
                 On failure it stays up and reports, because the section labels that used
                 to carry that message are gone as of this stage. -->
            <!-- Stage 6B.17: Grid.RowSpan="2" is the whole fix. This Grid defines two rows -
                 the 93px header, then the page - and a child with no Grid.Row lands in row 0
                 by default. So the overlay was drawn inside the header strip: a dim band
                 across the top with the card crushed into 93px, instead of covering the
                 window. Panel.ZIndex was right and made no difference, because the element
                 never had the size to cover anything in the first place. -->
            <!-- Deep check 1: the status note. Shows what the app just did for a few seconds
                 (ShowNotice in code); clicks pass through it. -->
            <Border x:Name="NoticeToast"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Panel.ZIndex="950"
                    Visibility="Collapsed"
                    Opacity="0"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,26"
                    MaxWidth="640"
                    Background="{StaticResource CfDeepBlue}"
                    CornerRadius="12"
                    Padding="11,9,16,9">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.25" Color="#183153" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="NoticeDot" Width="20" Height="20" CornerRadius="10" Background="#2FB866" VerticalAlignment="Center">
                        <Grid>
                            <Path x:Name="NoticeTick" Data="M2,6.5 L4.8,9.2 L10,3.5" Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Path x:Name="NoticeBang" Data="M2,1.5 L2,6.5 M2,9.3 L2,9.5" Stroke="{StaticResource CfDeepBlue}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"
                                  Width="4" Height="11" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="NoticeText" Foreground="White" FontFamily="Arial" FontSize="12" FontWeight="Bold"
                               Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="590" />
                </StackPanel>
            </Border>

            <Grid x:Name="RetrievalOverlay"
                  Grid.Row="0"
                  Grid.RowSpan="2"
                  Visibility="Collapsed"
                  Background="#590C2850"
                  Panel.ZIndex="900">
                <Border Background="White"
                        CornerRadius="14"
                        Padding="20,16"
                        MinWidth="230"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.22" Color="#0C2850" />
                    </Border.Effect>
                    <StackPanel>
                        <!-- Stage 6B.70 (R1): navy band reaching over the card's 20,16 padding. -->
                        <Border Background="{StaticResource CfDeepBlue}" CornerRadius="13,13,0,0" Margin="-20,-16,-20,12" Padding="20,13">
                        <StackPanel Orientation="Horizontal">
                            <!-- Stage 6B.12: the rotation is started from code rather than a XAML
                                 EventTrigger storyboard. Same animation, fewer ways for the XAML
                                 compiler to object. -->
                            <Ellipse x:Name="RetrievalSpinner"
                                     Width="22" Height="22"
                                     Stroke="White"
                                     StrokeThickness="3"
                                     StrokeDashArray="3.1 1.4"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="RetrievalSpinnerRotate" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <TextBlock x:Name="RetrievalTitle"
                                       Text="Retrieving reports"
                                       Foreground="White"
                                       FontFamily="Arial" FontSize="12.5" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        </Border>

                        <StackPanel x:Name="RetrievalSteps">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock x:Name="RetrievalStep1Marker" Text="&#9675;" Width="16" FontFamily="Arial" FontSize="11.5" Foreground="{StaticResource CfMuted}" VerticalAlignment="Center" />
                                <TextBlock x:Name="RetrievalStep1Text" Text="Team Performance" FontFamily="Arial" FontSize="11.5" Foreground="{StaticResource CfMuted}" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock x:Name="RetrievalStep2Marker" Text="&#9675;" Width="16" FontFamily="Arial" FontSize="11.5" Foreground="{StaticResource CfMuted}" VerticalAlignment="Center" />
                                <TextBlock x:Name="RetrievalStep2Text" Text="Gift Cards" FontFamily="Arial" FontSize="11.5" Foreground="{StaticResource CfMuted}" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="RetrievalStep3Marker" Text="&#9675;" Width="16" FontFamily="Arial" FontSize="11.5" Foreground="{StaticResource CfMuted}" VerticalAlignment="Center" />
                                <TextBlock x:Name="RetrievalStep3Text" Text="Branch Performance" FontFamily="Arial" FontSize="11.5" Foreground="{StaticResource CfMuted}" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                            <!-- Shown only when Refresh runs from the Reports section, the only time
                                 the Discounts and Price Overrides report is pulled. -->
                            <StackPanel x:Name="RetrievalStep4Row" Orientation="Horizontal" Margin="0,5,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="RetrievalStep4Marker" Text="&#9675;" Width="16" FontFamily="Arial" FontSize="11.5" Foreground="{StaticResource CfMuted}" VerticalAlignment="Center" />
                                <TextBlock x:Name="RetrievalStep4Text" Text="Staff Discounts" FontFamily="Arial" FontSize="11.5" Foreground="{StaticResource CfMuted}" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="RetrievalErrorText"
                                   Visibility="Collapsed"
                                   MaxWidth="300"
                                   TextWrapping="Wrap"
                                   Foreground="#C53D46"
                                   FontFamily="Arial" FontSize="11"
                                   Margin="0,10,0,0" />

                        <Button x:Name="RetrievalDismissButton"
                                Visibility="Collapsed"
                                Content="Close"
                                Tag="NoGlyph"
                                Style="{StaticResource FlooidActionButtonStyle}"
                                Height="24"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0"
                                Click="RetrievalDismiss_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

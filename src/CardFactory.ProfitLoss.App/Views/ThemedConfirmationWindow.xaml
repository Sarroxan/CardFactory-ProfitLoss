<Window x:Class="CardFactory.ProfitLoss.App.Views.ThemedConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm"
        Width="465"
        Height="320"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">
    <Border Margin="12"
            Padding="22"
            Background="White"
            BorderBrush="{StaticResource CfLine}"
            BorderThickness="1"
            CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.20" Color="#183153" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Stage 6B.61: navy header band, matching the main window's navy header. It
                 reaches out over the card's 22px padding to the card's edges. -->
            <Border Margin="-22,-22,-22,0" Padding="22,16,22,16"
                    Background="{StaticResource CfDeepBlue}" CornerRadius="19,19,0,0">
                <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" Background="#FFF0F1" BorderBrush="#F0C9CD" BorderThickness="1" CornerRadius="12">
                            <Grid Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M11,2 L20,19 L2,19 Z"
                                      Stroke="{StaticResource CfBad}" StrokeThickness="1.6" Fill="Transparent" StrokeLineJoin="Round" />
                                <Path Data="M11,7 L11,13 M11,16 L11,16.1"
                                      Stroke="{StaticResource CfBad}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Grid>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText" Foreground="White" FontFamily="Arial" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="This action changes saved preferences" Foreground="#D6E4F5" FontFamily="Arial" FontSize="9" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Width="30" Height="30" Content="×" FontSize="18"
                            Style="{StaticResource NavyBandCloseButtonStyle}" Click="Cancel_Click" />
                </Grid>
            </Border>

            <TextBlock x:Name="QuestionText" Grid.Row="1" Margin="0,20,0,0"
                       Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" />

            <Border Grid.Row="2" Margin="0,13,0,0" Padding="12,11"
                    Background="#FFF9F9" BorderBrush="#F0C9CD" BorderThickness="1" CornerRadius="12">
                <TextBlock x:Name="DetailText" Foreground="{StaticResource CfMuted}" FontFamily="Arial" FontSize="9.5" LineHeight="15" TextWrapping="Wrap" />
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel" Width="88" Height="34" Style="{StaticResource ModernSecondaryButtonStyle}" Click="Cancel_Click" />
                <Button x:Name="ConfirmButton" Width="112" Height="34" Margin="8,0,0,0" Style="{StaticResource DangerOutlineButtonStyle}" Click="Confirm_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

<Window x:Class="CardFactory.ProfitLoss.App.Views.DailyBriefingPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Daily Briefing"
        Width="1140"
        Height="860"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">
    <Window.Resources>
        <!-- Yellow is for what you act on (6B.06), as on Refresh. -->
        <!-- D3 (owner, 16 Oct 2026): the zoom switch and the page arrows. -->
        <Style x:Key="ZoomSegmentStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#22FFFFFF" /></Trigger>
                            <Trigger Property="Tag" Value="On">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource CfYellow}" />
                                <Setter Property="Foreground" Value="{StaticResource CfDeepBlue}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PageArrowStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="E" Fill="{StaticResource CfDeepBlue}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="E" Property="Fill" Value="#0A5BBF" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="E" Property="Fill" Value="#C9D6E6" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrintButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource CfDeepBlue}" />
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{StaticResource CfYellow}" BorderBrush="#E0AC00" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#FFD53D" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#F2BC00" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- Export to Daily Briefing (concept M1): the filled-in sheet, shown before it goes
         anywhere. Same card and navy band as the other dialogs. -->
    <Border Margin="12"
            Background="White"
            BorderBrush="{StaticResource CfLine}"
            BorderThickness="1"
            CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.20" Color="#183153" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Padding="20,12,14,12" Background="{StaticResource CfDeepBlue}" CornerRadius="19,19,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText" Text="Daily Briefing" Foreground="White"
                               FontFamily="{StaticResource CfTitleFont}" FontSize="24" VerticalAlignment="Center" />
                    <!-- D3: − / Fit page / 100% / +. Opens on Fit page, so it never starts zoomed in. -->
                    <Border Grid.Column="1" Background="#22FFFFFF" CornerRadius="9" Height="30" Margin="0,0,12,0" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ZoomOutButton" Content="−" FontSize="14" Style="{StaticResource ZoomSegmentStyle}" Click="ZoomOut_Click" ToolTip="Smaller" />
                            <Button x:Name="FitPageButton" Content="Fit page" Tag="On" Style="{StaticResource ZoomSegmentStyle}" Click="FitPage_Click" ToolTip="Show the whole page" />
                            <Button x:Name="ActualSizeButton" Content="100%" Style="{StaticResource ZoomSegmentStyle}" Click="ActualSize_Click" ToolTip="Full size, to read the figures" />
                            <Button x:Name="ZoomInButton" Content="+" FontSize="14" Style="{StaticResource ZoomSegmentStyle}" Click="ZoomIn_Click" ToolTip="Bigger" />
                        </StackPanel>
                    </Border>
                    <Button Grid.Column="2" Content="Save as PDF" Height="32" Padding="14,0"
                            Style="{StaticResource ModernSecondaryButtonStyle}" Click="SavePdf_Click"
                            ToolTip="Save with Microsoft Print to PDF" />
                    <Button Grid.Column="3" Content="Print" Height="32" Padding="22,0" Margin="8,0,0,0"
                            Style="{StaticResource PrintButtonStyle}"
                            Click="Print_Click" />
                    <Button Grid.Column="4" Width="30" Height="30" Margin="12,0,0,0" Content="×" FontSize="18"
                            Style="{StaticResource NavyBandCloseButtonStyle}" Click="Close_Click" />
                </Grid>
            </Border>

            <!-- Shown only when a part of the sheet had no figures to fill in. -->
            <Border x:Name="MissingBanner" Grid.Row="1" Visibility="Collapsed"
                    Background="#FFF1DC" Padding="20,7">
                <TextBlock x:Name="MissingText" Foreground="#9A5B00" FontFamily="Arial" FontSize="11"
                           FontWeight="Bold" TextWrapping="Wrap" />
            </Border>

            <!-- D3 (owner, 16 Oct 2026): one page at a time. Fit page (the default) shrinks the whole
                 sheet into the window; a zoom step shows it bigger and the bars scroll it. The old
                 viewer fitted the page to the WIDTH, so on a till screen it was taller than the
                 window: zoomed in with the bottom cut off. -->
            <Grid Grid.Row="2" Margin="1,0,1,14" Background="#EDF1F6" ClipToBounds="True">
                <ScrollViewer x:Name="PageScroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="PageScroller_PreviewMouseWheel" Focusable="False">
                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CfTeamScrollBarStyle}" />
                    </ScrollViewer.Resources>
                    <!-- The shadow is its own shape behind the page: an Effect on the page itself would
                         turn its text into a blurred bitmap. -->
                    <Grid x:Name="PageFrame" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,16,18,52">
                        <Border Background="White">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" Color="#0C2850" />
                            </Border.Effect>
                        </Border>
                        <DocumentPageView x:Name="PageView" Stretch="Uniform" StretchDirection="Both" />
                    </Grid>
                </ScrollViewer>
                <!-- Page 1 of 2, over the bottom of the page area. -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
                        Background="White" BorderBrush="{StaticResource CfLine}" BorderThickness="1.5" CornerRadius="15" Padding="4,3">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="PreviousPageButton" Style="{StaticResource PageArrowStyle}" Click="PreviousPage_Click" ToolTip="Previous page">
                            <Path Data="M7,2 L3,6 L7,10" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Button>
                        <TextBlock x:Name="PageText" Text="Page 1 of 2" Margin="10,0" VerticalAlignment="Center"
                                   FontFamily="Arial" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource CfDeepBlue}" />
                        <Button x:Name="NextPageButton" Style="{StaticResource PageArrowStyle}" Click="NextPage_Click" ToolTip="Next page">
                            <Path Data="M3,2 L7,6 L3,10" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

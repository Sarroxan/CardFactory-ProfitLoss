<Window x:Class="CardFactory.ProfitLoss.App.Views.PrintSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">
    <!-- Owner, 4 Nov 2026 (concept M1): the app's own print box, opened from "Change…" above the
         preview. Filled in with the settings kept on this till; what is chosen here is kept for
         next time (apart from Pages, which always starts at All pages). -->
    <Window.Resources>
        <Style x:Key="RowLabelStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="110" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource CfMuted}" />
        </Style>
        <Style x:Key="RowStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource CfLineSoft}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,9" />
        </Style>
        <!-- One half of a two-way switch (Colour / Black & white …). -->
        <Style x:Key="SegmentStyle" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource CfDeepBlue}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="B" Background="Transparent" CornerRadius="8" Padding="13,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{StaticResource CfDeepBlue}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StepButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource CfDeepBlue}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{StaticResource CfBlueSoft}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrinterRowStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource CfDeepBlue}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent" Padding="12,7" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{StaticResource CfBlueSoft}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrintButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource CfDeepBlue}" />
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{StaticResource CfYellow}" BorderBrush="#E0AC00" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#FFD53D" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#F2BC00" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12" Background="White" BorderBrush="{StaticResource CfLine}" BorderThickness="1" CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.20" Color="#183153" />
        </Border.Effect>
        <StackPanel>
            <Border Padding="20,12,14,12" Background="{StaticResource CfDeepBlue}" CornerRadius="19,19,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText" Text="Print" Foreground="White"
                               FontFamily="{StaticResource CfTitleFont}" FontSize="24" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Width="30" Height="30" Content="×" FontSize="18"
                            Style="{StaticResource NavyBandCloseButtonStyle}" Click="Cancel_Click" />
                </Grid>
            </Border>

            <StackPanel Margin="20,8,20,18">
                <!-- Printer: the till's printers, the normal one first. -->
                <Border Style="{StaticResource RowStyle}" BorderThickness="0">
                    <DockPanel>
                        <TextBlock Text="PRINTER" Style="{StaticResource RowLabelStyle}" />
                        <Grid>
                            <Button x:Name="PrinterButton" Height="32" Cursor="Hand" Click="PrinterButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="White" BorderBrush="{StaticResource CfLine}" BorderThickness="1" CornerRadius="9" Padding="12,0">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="▾" Foreground="{StaticResource CfDeepBlue}" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock x:Name="PrinterNameText" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                           Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="12" FontWeight="Bold"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Popup x:Name="PrinterPopup" PlacementTarget="{Binding ElementName=PrinterButton}" Placement="Bottom"
                                   StaysOpen="False" AllowsTransparency="True" VerticalOffset="4"
                                   Width="{Binding ActualWidth, ElementName=PrinterButton}">
                                <Border Background="White" BorderBrush="{StaticResource CfLine}" BorderThickness="1" CornerRadius="10" Padding="4">
                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="PrinterList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding}" Tag="{Binding}" Style="{StaticResource PrinterRowStyle}" Click="PrinterChoice_Click" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource RowStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="COPIES" Style="{StaticResource RowLabelStyle}" />
                        <Border BorderBrush="{StaticResource CfLine}" BorderThickness="1" CornerRadius="9" Height="32" ClipToBounds="True">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="−" Style="{StaticResource StepButtonStyle}" Click="FewerCopies_Click" />
                                <Border BorderBrush="{StaticResource CfBlueSoft}" BorderThickness="1,0" Width="36">
                                    <TextBlock x:Name="CopiesText" Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontFamily="Arial" FontSize="13" FontWeight="Bold" Foreground="{StaticResource CfDeepBlue}" />
                                </Border>
                                <Button Content="+" Style="{StaticResource StepButtonStyle}" Click="MoreCopies_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="ColourRow" Style="{StaticResource RowStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="COLOUR" Style="{StaticResource RowLabelStyle}" />
                        <Border Background="{StaticResource CfBlueSoft}" CornerRadius="10" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ColourChoice" GroupName="Colour" Content="Colour" Style="{StaticResource SegmentStyle}" />
                                <RadioButton x:Name="BlackWhiteChoice" GroupName="Colour" Content="Black &amp; white" Style="{StaticResource SegmentStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="SidesRow" Style="{StaticResource RowStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SIDES" Style="{StaticResource RowLabelStyle}" />
                        <Border Background="{StaticResource CfBlueSoft}" CornerRadius="10" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="BothSidesChoice" GroupName="Sides" Content="Both sides (short edge)" Style="{StaticResource SegmentStyle}" />
                                <RadioButton x:Name="OneSideChoice" GroupName="Sides" Content="One side" Style="{StaticResource SegmentStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="PagesRow" Style="{StaticResource RowStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PAGES" Style="{StaticResource RowLabelStyle}" />
                        <Border Background="{StaticResource CfBlueSoft}" CornerRadius="10" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="AllPagesChoice" GroupName="Pages" Content="All pages" IsChecked="True" Style="{StaticResource SegmentStyle}" />
                                <RadioButton x:Name="FirstPageChoice" GroupName="Pages" Content="Page 1 only" Style="{StaticResource SegmentStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource RowStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PAPER" Style="{StaticResource RowLabelStyle}" />
                        <TextBlock x:Name="PaperText" VerticalAlignment="Center" FontFamily="Arial" FontSize="12">
                            <Run x:Name="PaperRun" Text="A4 · landscape · fit to page" FontWeight="Bold" Foreground="{StaticResource CfDeepBlue}" />
                            <Run Text=" (always)" Foreground="{StaticResource CfMuted}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="NoteText" Margin="0,10,0,0" FontFamily="Arial" FontSize="11" Foreground="{StaticResource CfMuted}" TextWrapping="Wrap"
                           Text="These are filled in for you and kept for next time on this till." />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Cancel" Width="88" Height="34" Style="{StaticResource ModernSecondaryButtonStyle}" Click="Cancel_Click" />
                    <Button Content="Print" Height="34" Padding="26,0" Margin="8,0,0,0" Style="{StaticResource PrintButtonStyle}" Click="Print_Click" IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

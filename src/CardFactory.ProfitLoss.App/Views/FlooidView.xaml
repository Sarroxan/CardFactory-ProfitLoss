<UserControl x:Class="CardFactory.ProfitLoss.App.Views.FlooidView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="White">
    <Grid Background="White">
        <wv2:WebView2 x:Name="Browser" />

        <Border x:Name="BrowserErrorPanel"
                Visibility="Collapsed"
                Background="White"
                Padding="36">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="560">
                <Border Width="54"
                        Height="54"
                        Background="#FFF5BF"
                        CornerRadius="17"
                        Margin="0,0,0,12">
                    <Grid>
                        <Path Data="M9,3 L9,13 M5,9 L9,13 L13,9 M3,17 L15,17"
                              Stroke="{StaticResource CfDeepBlue}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="22"
                              Height="22"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <TextBlock Text="Flooid browser could not start"
                           Foreground="{StaticResource CfDeepBlue}"
                           FontFamily="Arial"
                           FontSize="18"
                           FontWeight="Bold"
                           TextAlignment="Center" />
                <TextBlock x:Name="BrowserErrorText"
                           Foreground="{StaticResource CfMuted}"
                           FontFamily="Arial"
                           FontSize="10.5"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,9,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<Window x:Class="CardFactory.ProfitLoss.App.Views.ThemedDatePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Date"
        Width="410"
        Height="577"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="CalendarNavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="#F7F9FC" />
            <Setter Property="BorderBrush" Value="{StaticResource CfLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource CfDeepBlue}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#FFF8D8" />
                                <Setter TargetName="NavBorder" Property="BorderBrush" Value="{StaticResource CfYellow}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#FFF0A8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CalendarDayButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource CfDeepBlue}" />
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DayBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Other">
                                <Setter Property="Opacity" Value="0.34" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Today">
                                <Setter TargetName="DayBorder" Property="Background" Value="#FFF8D8" />
                                <Setter TargetName="DayBorder" Property="BorderBrush" Value="{StaticResource CfYellow}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="InRange">
                                <Setter TargetName="DayBorder" Property="Background" Value="{StaticResource CfBlueSoft}" />
                                <Setter TargetName="DayBorder" Property="CornerRadius" Value="0" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="DayBorder" Property="Background" Value="{StaticResource CfDeepBlue}" />
                                <Setter TargetName="DayBorder" Property="BorderBrush" Value="{StaticResource CfYellow}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DayBorder" Property="Background" Value="#EEF5FF" />
                                <Setter TargetName="DayBorder" Property="BorderBrush" Value="#B9CDE5" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Selected" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="DayBorder" Property="Background" Value="#0057A8" />
                                <Setter TargetName="DayBorder" Property="BorderBrush" Value="{StaticResource CfYellow}" />
                                <Setter Property="Foreground" Value="White" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- K1: Single day / Date range, chosen in the calendar itself. -->
        <Style x:Key="PeriodTabStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource CfDeepBlue}" />
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Seg" Background="Transparent" BorderBrush="Transparent" BorderThickness="2" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Seg" Property="Background" Value="#F5F9FF" /></Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Seg" Property="Background" Value="{StaticResource CfBlue}" />
                                <Setter TargetName="Seg" Property="BorderBrush" Value="{StaticResource CfYellow}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12"
            Padding="20"
            Background="White"
            BorderBrush="{StaticResource CfLine}"
            BorderThickness="1"
            CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.20" Color="#183153" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Stage 6B.61: navy header band, matching the main window's navy header. It
                 reaches out over the card's 20px padding to the card's edges. -->
            <Border Margin="-20,-20,-20,0" Padding="20,16,20,16"
                    Background="{StaticResource CfDeepBlue}" CornerRadius="19,19,0,0">
                <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" Background="#FFF6C9" BorderBrush="#F0DE94" BorderThickness="1" CornerRadius="12">
                            <Grid Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M3,6 L17,6 M6,2.5 L6,7.5 M14,2.5 L14,7.5 M3,6 L3,17 L17,17 L17,6 Z"
                                      Stroke="{StaticResource CfDeepBlue}" StrokeThickness="1.6" StrokeLineJoin="Round" Fill="Transparent" />
                                <Path Data="M6,10 L8.5,12.5 L14,8"
                                      Stroke="{StaticResource CfYellow}" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Grid>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="DialogTitleText" Foreground="White" FontFamily="Arial" FontSize="18" FontWeight="Bold" />
                            <TextBlock x:Name="DialogHintText" Foreground="#D6E4F5" FontFamily="Arial" FontSize="9" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Width="30" Height="30" Content="×" FontSize="18"
                            Style="{StaticResource NavyBandCloseButtonStyle}" Click="Cancel_Click" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="0,16,0,0" Height="36" Padding="3" Background="{StaticResource CfBlueSoft}" CornerRadius="12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="3" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button x:Name="SingleDayTab" Content="Single day" Style="{StaticResource PeriodTabStyle}" Click="SingleDayTab_Click" />
                    <Button x:Name="DateRangeTab" Grid.Column="2" Content="Date range" Style="{StaticResource PeriodTabStyle}" Click="DateRangeTab_Click" />
                </Grid>
            </Border>
            <Border Grid.Row="2" Margin="0,14,0,0" Padding="10,8"
                    Background="#FFFDF4" BorderBrush="#F0DE94" BorderThickness="1" CornerRadius="13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="‹" Style="{StaticResource CalendarNavButtonStyle}" Click="PreviousMonth_Click" />
                    <TextBlock x:Name="MonthTitleText" Grid.Column="1"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="14" FontWeight="Bold" />
                    <Button Grid.Column="2" Content="›" Style="{StaticResource CalendarNavButtonStyle}" Click="NextMonth_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,14,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="MON" Style="{StaticResource CalendarWeekHeaderStyle}" />
                <TextBlock Grid.Column="1" Text="TUE" Style="{StaticResource CalendarWeekHeaderStyle}" />
                <TextBlock Grid.Column="2" Text="WED" Style="{StaticResource CalendarWeekHeaderStyle}" />
                <TextBlock Grid.Column="3" Text="THU" Style="{StaticResource CalendarWeekHeaderStyle}" />
                <TextBlock Grid.Column="4" Text="FRI" Style="{StaticResource CalendarWeekHeaderStyle}" />
                <TextBlock Grid.Column="5" Text="SAT" Style="{StaticResource CalendarWeekHeaderStyle}" />
                <TextBlock Grid.Column="6" Text="SUN" Style="{StaticResource CalendarWeekHeaderStyle}" />
            </Grid>

            <UniformGrid x:Name="DaysGrid" Grid.Row="4" Rows="6" Columns="7" Margin="0,1,0,0" />

            <!-- Stage 6B.46 (option B): a click on a day uses it and closes, so "Use date" is
                 gone, and Cancel with it - the × in the header already cancels. Today stays
                 as a one-click shortcut and closes too. -->
            <Grid Grid.Row="5" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="TodayButton" Content="Today" Width="72" Height="34" HorizontalAlignment="Left" Style="{StaticResource ModernSecondaryButtonStyle}" Click="Today_Click" />
                <Button x:Name="ThisWeekButton" Content="This week" Width="86" Height="34" HorizontalAlignment="Left" Style="{StaticResource ModernSecondaryButtonStyle}" Click="ThisWeek_Click" Visibility="Collapsed" />
                <TextBlock x:Name="RangeSummaryText" Grid.Column="1" Margin="10,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial" FontSize="11" FontWeight="Bold" Visibility="Collapsed" />
                <Button x:Name="UseDatesButton" Grid.Column="2" Content="Use dates" Height="34" Padding="16,0" IsEnabled="False"
                        Style="{StaticResource FlooidActionButtonStyle}" Tag="NoGlyph" FontSize="11" Click="UseDates_Click" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Border>
</Window>

<Window x:Class="CardFactory.ProfitLoss.App.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update available"
        Width="430"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">
    <!-- Update design U2: the dialogs' navy band, what changed, then Later / Update and restart. -->
    <Border Margin="12"
            Padding="22"
            Background="White"
            BorderBrush="{StaticResource CfLine}"
            BorderThickness="1"
            CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.20" Color="#183153" />
        </Border.Effect>
        <StackPanel>
            <Border Margin="-22,-22,-22,0" Padding="22,16,22,16"
                    Background="{StaticResource CfDeepBlue}" CornerRadius="19,19,0,0">
                <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" Background="#FFF6C9" CornerRadius="12">
                            <Path Data="M10,3 L10,13 M6,9 L10,13 L14,9 M4,16 L16,16" Stroke="{StaticResource CfDeepBlue}" StrokeThickness="1.9"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="20" Height="20" Stretch="Uniform" />
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Update available" Foreground="White" FontFamily="Arial" FontSize="18" FontWeight="Bold" />
                            <TextBlock x:Name="VersionText" Foreground="#D6E4F5" FontFamily="Arial" FontSize="10" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="CloseButton" Grid.Column="1" Width="30" Height="30" Content="×" FontSize="18"
                            Style="{StaticResource NavyBandCloseButtonStyle}" Click="Later_Click" />
                </Grid>
            </Border>

            <TextBlock Text="WHAT'S NEW" Margin="0,18,0,6" Foreground="{StaticResource CfMuted}"
                       FontFamily="Arial" FontSize="9.5" FontWeight="Bold" />
            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="NotesText" Foreground="{StaticResource CfDeepBlue}" FontFamily="Arial"
                           FontSize="12" LineHeight="19" TextWrapping="Wrap" />
            </ScrollViewer>

            <!-- Progress design P2: three steps, the bar on the download. Hidden until Update. -->
            <Border x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,14,0,0" Padding="12,8"
                    Background="#FBFCFD" BorderBrush="#E3EAF3" BorderThickness="1" CornerRadius="12">
                <StackPanel>
                    <Grid Height="26">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid Width="18" Height="18" HorizontalAlignment="Left">
                            <Ellipse x:Name="Step0Ring" Stroke="#C9D6E6" StrokeThickness="1.5" />
                            <Ellipse x:Name="Step0Done" Fill="#0B7A35" Visibility="Collapsed" />
                            <Path x:Name="Step0Tick" Data="M4,10 L8,14 L16,6" Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Width="10" Height="10" Stretch="Uniform" Visibility="Collapsed" />
                        </Grid>
                        <TextBlock x:Name="Step0Label" Grid.Column="1" Text="Downloading" VerticalAlignment="Center" Foreground="#98A6B8"
                                   FontFamily="Arial" FontSize="12" FontWeight="Bold" />
                        <TextBlock x:Name="Step0Detail" Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource CfMuted}" FontFamily="Arial" FontSize="10.5" />
                    </Grid>
                    <ProgressBar x:Name="DownloadBar" Height="8" Minimum="0" Maximum="100" Value="0" Margin="28,2,0,8">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Grid>
                                    <Border x:Name="PART_Track" Background="#E6EDF6" CornerRadius="4" />
                                    <Border x:Name="PART_Indicator" Background="{StaticResource CfBlue}" CornerRadius="4" HorizontalAlignment="Left" />
                                </Grid>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                    <Grid Height="26">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid Width="18" Height="18" HorizontalAlignment="Left">
                            <Ellipse x:Name="Step1Ring" Stroke="#C9D6E6" StrokeThickness="1.5" />
                            <Ellipse x:Name="Step1Done" Fill="#0B7A35" Visibility="Collapsed" />
                            <Path x:Name="Step1Tick" Data="M4,10 L8,14 L16,6" Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Width="10" Height="10" Stretch="Uniform" Visibility="Collapsed" />
                        </Grid>
                        <TextBlock x:Name="Step1Label" Grid.Column="1" Text="Checking the download" VerticalAlignment="Center" Foreground="#98A6B8"
                                   FontFamily="Arial" FontSize="12" FontWeight="Bold" />
                    </Grid>
                    <Grid Height="26">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid Width="18" Height="18" HorizontalAlignment="Left">
                            <Ellipse x:Name="Step2Ring" Stroke="#C9D6E6" StrokeThickness="1.5" />
                            <Ellipse x:Name="Step2Done" Fill="#0B7A35" Visibility="Collapsed" />
                            <Path x:Name="Step2Tick" Data="M4,10 L8,14 L16,6" Stroke="White" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Width="10" Height="10" Stretch="Uniform" Visibility="Collapsed" />
                        </Grid>
                        <TextBlock x:Name="Step2Label" Grid.Column="1" Text="Installing and restarting" VerticalAlignment="Center" Foreground="#98A6B8"
                                   FontFamily="Arial" FontSize="12" FontWeight="Bold" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" Margin="0,12,0,0" Foreground="{StaticResource CfMuted}" FontFamily="Arial"
                       FontSize="10" TextWrapping="Wrap"
                       Text="The app downloads the update, checks it, and restarts. Your settings stay as they are." />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="LaterButton" Content="Later" Width="88" Height="34"
                        Style="{StaticResource ModernSecondaryButtonStyle}" Click="Later_Click" />
                <Button x:Name="UpdateNowButton" Content="Update and restart" Height="34" MinWidth="150" Margin="8,0,0,0" Padding="16,0"
                        Tag="NoGlyph" Style="{StaticResource FlooidActionButtonStyle}" Click="UpdateNow_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

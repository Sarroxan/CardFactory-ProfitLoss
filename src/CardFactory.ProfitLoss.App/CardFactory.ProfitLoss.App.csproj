<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>CardFactory.ProfitLoss</AssemblyName>
    <RootNamespace>CardFactory.ProfitLoss.App</RootNamespace>
    <ApplicationTitle>Card Factory Profit &amp; Loss Calculator</ApplicationTitle>
    <ApplicationIcon>Assets\CardFactory.ProfitLoss.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>

    <!-- Smaller download (v1.3.0 was 69 MB; the exe 165 MB, of which the app is ~1 MB).
         The published exe carries the .NET and WPF runtime so it runs without installing
         anything; these drop the parts of it this app never uses. -->
    <!-- English only: leaves out the 13 translations of the framework's own messages
         (cs, de, es, fr, it, ja, ko, pl, pt-BR, ru, tr, zh-Hans, zh-Hant), ~16.5 MB. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- No Windows Forms: the app is WPF and uses none of it (~24 MB). It came in only
         because the WebView2 package declares framework references for both its WPF and
         its WinForms controls; the WPF control and Core are what the app uses. -->
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
    <!-- The WebView2 IntelliSense files (.xml) are for developers, not users. -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Web.WebView2" />
    <!-- Stage 6B.19: DPAPI, for the optional remembered Flooid password. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\CardFactory.ProfitLoss.ico" />
    <None Remove="Assets\HeaderSmiley.png" />
    <None Remove="Assets\SectionSmiley.png" />
    <None Remove="Assets\HeaderLogoTitle.png" />
    <Resource Include="Assets\CardFactory.ProfitLoss.ico" />
    <Resource Include="Assets\HeaderSmiley.png" />
    <Resource Include="Assets\SectionSmiley.png" />
    <Resource Include="Assets\HeaderLogoTitle.png" />
    <Resource Include="Assets\Fonts\Chewy-Regular.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CardFactory.ProfitLoss.Core\CardFactory.ProfitLoss.Core.csproj" />
    <ProjectReference Include="..\CardFactory.ProfitLoss.Flooid\CardFactory.ProfitLoss.Flooid.csproj" />
    <ProjectReference Include="..\CardFactory.ProfitLoss.ReportParsing\CardFactory.ProfitLoss.ReportParsing.csproj" />
    <ProjectReference Include="..\CardFactory.ProfitLoss.Storage\CardFactory.ProfitLoss.Storage.csproj" />
  </ItemGroup>
</Project>
